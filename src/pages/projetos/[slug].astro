---
// Página de detalhe de cada projeto: problema, solução, o rastro completo e o que só cabe aqui
// (correções do MCP, avaliação do Cardápio, capturas do InfoMachine, do CoreUFABC e do InfoCAIJ, o time de
// agentes do Kairo).
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Trace from '../../components/Trace.astro';
import CardapioJson from '../../components/CardapioJson.astro';
import { cartoes, numeros } from '../../data/cartoes';
import {
  avaliacaoCardapio as av,
  cardapio,
  copilotoKairo,
  coreufabc,
  kairo,
  ferramentasMcp,
  infocaij,
  infocaijMcp as mcp,
  infomachine,
  regrasKairo,
  timeKairo,
  type ProjetoCurto,
} from '../../data/projetos';
import type { Passo } from '../../lib/trace';
import { ptBR as s } from '../../i18n/pt-BR';
import posterSrc from '../../assets/mcp-poster.webp';
import videoUrl from '../../assets/infocaij-mcp-demo.mp4?url';
import gif from '../../assets/mcp-demo.gif';
import maqEquipamento from '../../assets/maq-equipamento.webp';
import maqRastreador from '../../assets/maq-rastreador.webp';
import maqTestes from '../../assets/maq-testes.webp';
import maqTeclado from '../../assets/maq-teclado.webp';
import maqTouchpad from '../../assets/maq-touchpad.webp';
import maqEtiqueta from '../../assets/maq-etiqueta.webp';
import kairoHoje from '../../assets/kairo-painel-hoje.webp';
import kairoRetornos from '../../assets/kairo-painel-retornos.webp';
import kairoServicos from '../../assets/kairo-cliente-servicos.webp';
import kairoPente from '../../assets/kairo-cliente-pente.webp';
import caijFluxo from '../../assets/caij-fluxo.webp';
import caijVenda from '../../assets/caij-venda.webp';
import caijEmbalagem from '../../assets/caij-embalagem.webp';
import caijEstoque from '../../assets/caij-estoque.webp';
import coreInicio from '../../assets/core-inicio.webp';
import corePlano from '../../assets/core-plano.webp';
import coreNotas from '../../assets/core-notas.webp';
import coreHistorico from '../../assets/core-historico.webp';
import coreGrade from '../../assets/core-grade.webp';

export function getStaticPaths() {
  return cartoes.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const i = cartoes.findIndex((c) => c.slug === slug);
const c = cartoes[i];
const proximo = cartoes[(i + 1) % cartoes.length];

const curtos: Record<string, ProjetoCurto> = {
  [cardapio.slug]: cardapio,
  [infocaij.slug]: infocaij,
  [infomachine.slug]: infomachine,
  [coreufabc.slug]: coreufabc,
  [kairo.slug]: kairo,
};
const curto = curtos[slug!];
const ehMcp = slug === mcp.slug;
const rastro: Passo[] = ehMcp ? mcp.rastro! : curto.rastro;
const perguntaInicial = rastro.find((p) => p.tipo === 'pergunta');
const problema = ehMcp ? mcp.problema : perguntaInicial?.tipo === 'pergunta' ? perguntaInicial.texto : '';
const solucao = ehMcp ? mcp.solucao : curto.resumo;
// No MCP o rastro abre com a pergunta real feita ao Claude; nos outros, o problema já está acima.
const passos = ehMcp ? rastro : rastro.filter((p) => p.tipo !== 'pergunta');

const poster = await getImage({ src: posterSrc, format: 'webp', width: 1600, quality: 75 });
// Galerias por projeto; `nota` acompanha cada legenda.
const galerias: Record<string, { nota: string; capturas: { src: ImageMetadata; legenda: string; alt: string }[] }> = {
  [infomachine.slug]: {
    nota: 'em uso na bancada',
    capturas: [
      { src: maqEquipamento, legenda: 'Leitura: 7 informações do hardware e o andamento em 4 etapas', alt: 'InfoMachine: hardware lido de um Lenovo ThinkPad E14 e o andamento da bancada.' },
      { src: maqRastreador, legenda: 'Rastreador: histórico por serial e cadastro no AlterTag (nomes borrados)', alt: 'InfoMachine: cadastro de rastreador com técnico, produto do catálogo e histórico por serial.' },
      { src: maqTestes, legenda: 'Testes: câmera, teclado, som, tela e touchpad, com resumo automático', alt: 'InfoMachine: central com os 5 testes de hardware.' },
      { src: maqTeclado, legenda: 'Teclado: mapa das 104 teclas, reconhecidas pelo código físico', alt: 'InfoMachine: teste de teclado com as teclas já reconhecidas em destaque.' },
      { src: maqTouchpad, legenda: 'Touchpad: movimento, cliques e rolagem contados', alt: 'InfoMachine: teste de mouse e touchpad com os contadores de movimento, cliques e rolagem.' },
      { src: maqEtiqueta, legenda: 'Etiqueta térmica de 80 × 50 mm, impressa por um serviço no NAS', alt: 'InfoMachine: prévia da etiqueta térmica com serial, configuração, rastreador e QR Code.' },
    ],
  },
  [infocaij.slug]: {
    nota: 'em produção',
    capturas: [
      { src: caijFluxo, legenda: 'Fluxo operacional no modo TV: a fila da bancada e as vendas do dia', alt: 'InfoCAIJ no modo TV: pedidos do dia, fila da bancada e vendas por empresa.' },
      { src: caijVenda, legenda: 'Nova venda: o pedido entra com código automático e vai para a bancada', alt: 'InfoCAIJ, tela Nova venda: dados da venda, produto e resumo do pedido.' },
      { src: caijEmbalagem, legenda: 'Embalagem: rastreador e nota fiscal antes de embalar (nome borrado)', alt: 'InfoCAIJ, tela Embalagem: pedido com rastreador e nota fiscal aguardando embalagem.' },
      { src: caijEstoque, legenda: 'Estoque: máquinas por modelo, conciliadas com o ERP', alt: 'InfoCAIJ, tela Estoque: 1.609 máquinas em 166 modelos, com a quantidade por modelo.' },
    ],
  },
};
const galeria = galerias[slug!];
const telasPc = [
  { src: kairoHoje, legenda: 'Hoje: o dia de cada barbeiro, com horários livres e o espaço do copiloto', alt: 'Tela Hoje do painel do Kairo (dados fictícios).' },
  { src: kairoRetornos, legenda: 'Retornos: quem está na hora de voltar, convites enviados e quem voltou', alt: 'Tela Retornos do painel do Kairo (dados fictícios).' },
];
const telasCel = [
  { src: kairoServicos, legenda: 'Página pública: escolha do serviço', alt: 'Página pública do Kairo no celular, com a lista de serviços (dados fictícios).' },
  { src: kairoPente, legenda: 'O "Pente": dia e horários livres', alt: 'Página pública do Kairo no celular, com a escolha do dia e dos horários (dados fictícios).' },
];
const telasCore = [
  { src: coreInicio, legenda: 'Início: CR, progressão e próximas pela rota', alt: 'CoreUFABC, tela Início (histórico fictício).' },
  { src: corePlano, legenda: 'Plano: rota curricular por bacharelado', alt: 'CoreUFABC, tela Plano (histórico fictício).' },
  { src: coreNotas, legenda: 'Notas: CR, CA, CP e simulador de CR', alt: 'CoreUFABC, tela Notas (histórico fictício).' },
  { src: coreHistorico, legenda: 'Histórico: progresso por eixo', alt: 'CoreUFABC, tela Histórico (histórico fictício).' },
  { src: coreGrade, legenda: 'Grade: horário do próximo quadrimestre', alt: 'CoreUFABC, tela Grade com quatro turmas (histórico fictício).' },
];
const num = String(i + 1).padStart(2, '0');
---

<Base title={`${c.nome} · ${s.nome}`} description={c.resumo}>
  <div class="pg" style={`--cor:var(--c-${c.cor})`}>
    <nav class="barra" aria-label="Navegação">
      <a href="/">← {s.nome}</a>
      <a href="/#projetos">Todos os projetos</a>
    </nav>

    <header class="cab">
      <p class="num" aria-hidden="true">{num}</p>
      <div class="tit">
        <p class="status">{c.status}</p>
        <h1>{c.nome}</h1>
      </div>
      <p class="lead">{c.resumo}</p>
      <div class="acoes">
        {
          c.link.href ? (
            <a class="link" href={c.link.href}>
              {c.link.rotulo} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="ghost todo">{c.link.rotulo}</span>
          )
        }
        <a class="ghost" href={`mailto:${s.links.email}`}>{s.falar}</a>
      </div>
    </header>

    {
      c.midia === 'video' && (
        <figure class="destaque video">
          <video controls muted playsinline preload="none" poster={poster.src} width="1908" height="986">
            <source src={videoUrl} type="video/mp4" />
            <img src={gif.src} width={gif.width} height={gif.height} alt="O InfoCAIJ MCP respondendo a perguntas no Claude Desktop." />
          </video>
          <figcaption>Vídeo de 37 s, sem som: o servidor respondendo no Claude Desktop. Nomes de funcionários borrados.</figcaption>
        </figure>
      )
    }
    {
      c.midia === 'cardapio' && (
        <figure class="destaque">
          <div class="moldura">
            <CardapioJson sizes="(min-width: 900px) 40vw, 100vw" />
          </div>
          <figcaption>Um dos 60 cardápios sintéticos e o JSON do gabarito: a cerveja sem preço fica marcada para revisão.</figcaption>
        </figure>
      )
    }
    {
      c.midia === 'carrossel' && (
        <ul class:list={['destaque galeria', { duas: galeria.capturas.length === 4 }]}>
          {galeria.capturas.map((cap) => (
            <li data-fade>
              <figure>
                <Image src={cap.src} alt={cap.alt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
                <figcaption>
                  {cap.legenda} · {galeria.nota}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }
    {
      c.midia === 'telas' && (
        <div class="destaque telas">
          <ul class="telas-pc">
            {telasPc.map((t) => (
              <li data-fade>
                <figure>
                  <Image src={t.src} alt={t.alt} widths={[720, 1100, 1600]} sizes="(min-width: 900px) 60vw, 100vw" loading="lazy" />
                  <figcaption>{t.legenda} · dados fictícios</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          <ul class="telas-cel">
            {telasCel.map((t) => (
              <li data-fade>
                <figure>
                  <Image src={t.src} alt={t.alt} widths={[320, 480, 720]} sizes="(min-width: 900px) 20vw, 45vw" loading="lazy" />
                  <figcaption>{t.legenda}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      c.midia === 'celulares' && (
        <div class="destaque">
          <ul class="celulares">
            {telasCore.map((t) => (
              <li data-fade>
                <figure>
                  <Image src={t.src} alt={t.alt} widths={[320, 480, 720]} sizes="(min-width: 900px) 18vw, 45vw" loading="lazy" />
                  <figcaption>{t.legenda}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          <p class="nota-fig">Telas com o histórico fictício do repositório (Aluno Mock UFA), não com dados reais.</p>
        </div>
      )
    }
    {
      slug === infocaij.slug && (
        <dl class="destaque nums">
          {numeros.map((n) => (
            <div data-fade>
              <dt>{n.v}</dt>
              <dd>{n.r}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <section class="bloco" aria-labelledby="h-problema">
      <h2 id="h-problema" class="rot">Problema</h2>
      <p class="texto" data-fade>{problema}</p>
    </section>

    <section class="bloco" aria-labelledby="h-solucao">
      <h2 id="h-solucao" class="rot">Solução</h2>
      <div data-fade>
        <p class="texto">{solucao}</p>
        {
          ehMcp && (
            <ul class="chips" aria-label="As 8 ferramentas do servidor">
              {ferramentasMcp.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )
        }
        {curto?.stack && <p class="stack">{curto.stack}</p>}
        {curto?.nota && <p class="stack">{curto.nota}</p>}
      </div>
    </section>

    <section class="bloco" aria-labelledby="h-rastro">
      <h2 id="h-rastro" class="rot">{ehMcp ? 'Uma execução real' : 'Como funciona'}</h2>
      <div>
        <Trace passos={passos} />
      </div>
    </section>

    {
      slug === kairo.slug && (
        <section class="bloco" aria-labelledby="h-time">
          <h2 id="h-time" class="rot">O time de agentes</h2>
          <div>
            <p class="texto" data-fade>
              Eu defini o produto, escrevi a especificação e aprovei cada entrega. O código foi escrito por um orquestrador e
              cinco agentes especialistas, cada um dono de uma área. O time completo tem 8 agentes; copiloto-ia, automacoes e
              qa-seguranca entram nas próximas fases.
            </p>
            <ol class="time" data-fade>
              {timeKairo.map((a) => (
                <li>
                  <p class="ag">{a.agente}</p>
                  <p class="dono">{a.dono}</p>
                  <p class="entregou">{a.entregou}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
    {
      slug === kairo.slug && (
        <section class="bloco" aria-labelledby="h-regras">
          <h2 id="h-regras" class="rot">Regras do time</h2>
          <ul class="lista" data-fade>
            {regrasKairo.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </section>
      )
    }
    {
      slug === kairo.slug && (
        <section class="bloco" aria-labelledby="h-copiloto">
          <h2 id="h-copiloto" class="rot">Próxima etapa: copiloto</h2>
          <div data-fade>
            <p class="texto">
              O profissional escreve ou fala em português ("fecha sexta à tarde, vou no médico") e o copiloto escolhe um de
              quatro agentes nomeados. O modelo propõe; a pessoa decide. Está especificado e ainda não foi construído.
            </p>
            <ul class="chips" aria-label="Agentes do copiloto">
              {copilotoKairo.agentes.map((a) => (
                <li>
                  <strong>{a.nome}</strong> · {a.cuida}
                </li>
              ))}
            </ul>
            <ul class="lista sub-lista">
              {copilotoKairo.regras.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
            <h3 class="sub">Metas da avaliação, num conjunto dourado de 40+ pedidos</h3>
            <dl class="aval">
              {copilotoKairo.metas.map((m) => (
                <div>
                  <dt>{m.v}</dt>
                  <dd>{m.r}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }
    {
      ehMcp && (
        <section class="bloco" aria-labelledby="h-correcoes">
          <h2 id="h-correcoes" class="rot">Avaliação e correções</h2>
          <div>
            <p class="texto" data-fade>
              Duas rodadas de teste acharam erros que a resposta certa escondia. Cada um virou uma correção com teste.
            </p>
            <ol class="correcoes">
              {mcp.correcoes!.map((k, n) => (
                <li class="correcao" data-fade style={`--d:${n * 120}ms`}>
                  <h3>{k.rotulo}</h3>
                  <dl>
                    <div class="falhou">
                      <dt>✗ falhou</dt>
                      <dd>{k.falhou}</dd>
                    </div>
                    <div>
                      <dt>causa</dt>
                      <dd>{k.causa}</dd>
                    </div>
                    <div>
                      <dt>ajuste</dt>
                      <dd>{k.ajuste}</dd>
                    </div>
                    <div class="passou">
                      <dt>✓ passou</dt>
                      <dd>{k.passou}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
    {
      ehMcp && (
        <section class="bloco" aria-labelledby="h-seguranca">
          <h2 id="h-seguranca" class="rot">Segurança</h2>
          <ul class="lista" data-fade>
            {mcp.seguranca!.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      slug === cardapio.slug && (
        <section class="bloco" aria-labelledby="h-avaliacao">
          <h2 id="h-avaliacao" class="rot">Avaliação</h2>
          <div>
            <p class="texto" data-fade>
              A métrica principal é o <strong>erro de preço silencioso</strong>: o preço errado que o modelo não marcou para
              revisão. É o erro que chega ao cliente sem ninguém ver.
            </p>
            <dl class="aval" data-fade>
              <div>
                <dt>{av.cardapios}</dt>
                <dd>cardápios sintéticos com gabarito exato</dd>
              </div>
              <div>
                <dt>{av.itens}</dt>
                <dd>itens no gabarito</dd>
              </div>
              <div>
                <dt>{av.estilos.length}</dt>
                <dd>estilos visuais: {av.estilos.join(', ')}</dd>
              </div>
              <div>
                <dt>{av.niveisFoto}</dt>
                <dd>níveis de qualidade de foto</dd>
              </div>
            </dl>
            <h3 class="sub">Armadilhas plantadas</h3>
            <ul class="barras" data-fade>
              {av.armadilhas.map((a) => (
                <li style={`--w:${a.n / Math.max(...av.armadilhas.map((x) => x.n))}`}>
                  <span class="n">{a.n}</span>
                  <span class="r">{a.rotulo}</span>
                  <i aria-hidden="true" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
    {
      slug === cardapio.slug && (
        <section class="bloco" aria-labelledby="h-preliminar">
          <h2 id="h-preliminar" class="rot">Resultado preliminar</h2>
          <div data-fade>
            <p class="texto">
              Em {av.preliminar.cardapios} cardápios: {av.preliminar.limpas}. Na foto difícil, o modelo leu dois preços errado e
              não pediu revisão:
            </p>
            <ul class="erros">
              {av.preliminar.erros.map((e) => (
                <li>
                  <span class="certo">R$ {e.certo}</span>
                  <span aria-hidden="true">→</span>
                  <span class="lido">lido como {e.lido}</span>
                </li>
              ))}
            </ul>
            <p class="todo-linha">TODO: atualizar com a rodada completa de 60 cardápios.</p>
          </div>
        </section>
      )
    }

    <nav class="proximo" aria-label="Próximo projeto" style={`--cor:var(--c-${proximo.cor})`}>
      <span class="k">próximo projeto</span>
      <a href={`/projetos/${proximo.slug}/`}>
        {proximo.nome} <span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Base>

<script>
  import '../../lib/motion-client';
</script>

<style>
  .pg {
    width: 100%;
    max-width: calc(72rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: 1.5rem var(--gutter) 4rem;
  }
  .barra {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .barra a {
    text-decoration: none;
    padding-block: 0.75rem;
  }
  .barra a:hover {
    color: var(--cor);
  }
  .cab {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.5rem;
    align-items: end;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
  }
  .num {
    margin: 0;
    font-size: clamp(4rem, 12vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cor);
    font-variation-settings: 'opsz' 72;
  }
  .status {
    margin: 0 0 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 72;
  }
  .lead {
    grid-column: 1 / -1;
    max-width: 44rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .acoes {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    background: var(--cor);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .link:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--cor) 85%, white);
  }

  /* Mídia de destaque: em largura total, com o contorno claro dos cartões. */
  .destaque {
    margin: 0 0 clamp(3rem, 8vw, 6rem);
  }
  .video video,
  .moldura {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(1.25rem, 3vw, 2.5rem);
    border: 2px solid var(--ink-soft);
    background: #000;
    overflow: hidden;
  }
  .moldura {
    background: var(--surface);
  }
  figcaption {
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .galeria {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .galeria figure {
    margin: 0;
  }
  .galeria :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    border: 2px solid var(--ink-soft);
  }
  /* Kairo: duas telas do painel grandes e as duas do celular ao lado. */
  .telas {
