---
// Página de detalhe de cada projeto: problema, solução, o rastro completo e o que só cabe aqui
// (correções do MCP, avaliação do Cardápio, capturas do InfoMachine, números do InfoCAIJ).
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Trace from '../../components/Trace.astro';
import CardapioJson from '../../components/CardapioJson.astro';
import { cartoes, numeros } from '../../data/cartoes';
import {
  avaliacaoCardapio as av,
  cardapio,
  coreufabc,
  ferramentasMcp,
  infocaij,
  infocaijMcp as mcp,
  infomachine,
  type ProjetoCurto,
} from '../../data/projetos';
import type { Passo } from '../../lib/trace';
import { ptBR as s } from '../../i18n/pt-BR';
import posterSrc from '../../assets/mcp-poster.webp';
import videoUrl from '../../assets/infocaij-mcp-demo.mp4?url';
import gif from '../../assets/mcp-demo.gif';
import painel from '../../assets/painel.png';
import testes from '../../assets/testes.png';
import etiqueta from '../../assets/etiqueta.png';

export function getStaticPaths() {
  return cartoes.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const i = cartoes.findIndex((c) => c.slug === slug);
const c = cartoes[i];
const proximo = cartoes[(i + 1) % cartoes.length];

const curtos: Record<string, ProjetoCurto> = {
  [cardapio.slug]: cardapio,
  [infocaij.slug]: infocaij,
  [infomachine.slug]: infomachine,
  [coreufabc.slug]: coreufabc,
};
const curto = curtos[slug!];
const ehMcp = slug === mcp.slug;
const rastro: Passo[] = ehMcp ? mcp.rastro! : curto.rastro;
const perguntaInicial = rastro.find((p) => p.tipo === 'pergunta');
const problema = ehMcp ? mcp.problema : perguntaInicial?.tipo === 'pergunta' ? perguntaInicial.texto : '';
const solucao = ehMcp ? mcp.solucao : curto.resumo;
// No MCP o rastro abre com a pergunta real feita ao Claude; nos outros, o problema já está acima.
const passos = ehMcp ? rastro : rastro.filter((p) => p.tipo !== 'pergunta');

const poster = await getImage({ src: posterSrc, format: 'webp', width: 1600, quality: 75 });
const capturas = [
  { src: painel, legenda: 'Painel: hardware lido da máquina', alt: 'Painel do InfoMachine com o hardware lido da máquina (valores de exemplo).' },
  { src: testes, legenda: 'Testes: câmera, teclado, som, tela e touchpad', alt: 'Tela de testes do InfoMachine (valores de exemplo).' },
  { src: etiqueta, legenda: 'Etiqueta térmica, impressa por um serviço no NAS', alt: 'Pré-visualização da etiqueta térmica gerada pelo InfoMachine (valores de exemplo).' },
];
const num = String(i + 1).padStart(2, '0');
---

<Base title={`${c.nome} · ${s.nome}`} description={c.resumo}>
  <div class="pg" style={`--cor:var(--c-${c.cor})`}>
    <nav class="barra" aria-label="Navegação">
      <a href="/">← {s.nome}</a>
      <a href="/#projetos">Todos os projetos</a>
    </nav>

    <header class="cab">
      <p class="num" aria-hidden="true">{num}</p>
      <div class="tit">
        <p class="status">{c.status}</p>
        <h1>{c.nome}</h1>
      </div>
      <p class="lead">{c.resumo}</p>
      <div class="acoes">
        {
          c.link.href ? (
            <a class="link" href={c.link.href}>
              {c.link.rotulo} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="ghost todo">{c.link.rotulo}</span>
          )
        }
        <a class="ghost" href={`mailto:${s.links.email}`}>{s.falar}</a>
      </div>
    </header>

    {
      c.midia === 'video' && (
        <figure class="destaque video">
          <video controls muted playsinline preload="none" poster={poster.src} width="1908" height="986">
            <source src={videoUrl} type="video/mp4" />
            <img src={gif.src} width={gif.width} height={gif.height} alt="O InfoCAIJ MCP respondendo a perguntas no Claude Desktop." />
          </video>
          <figcaption>Vídeo de 37 s, sem som: o servidor respondendo no Claude Desktop. Nomes de funcionários borrados.</figcaption>
        </figure>
      )
    }
    {
      c.midia === 'cardapio' && (
        <figure class="destaque">
          <div class="moldura">
            <CardapioJson sizes="(min-width: 900px) 40vw, 100vw" />
          </div>
          <figcaption>Um dos 60 cardápios sintéticos e o JSON do gabarito: a cerveja sem preço fica marcada para revisão.</figcaption>
        </figure>
      )
    }
    {
      c.midia === 'carrossel' && (
        <ul class="destaque galeria">
          {capturas.map((cap) => (
            <li data-fade>
              <figure>
                <Image src={cap.src} alt={cap.alt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
                <figcaption>{cap.legenda} · valores de exemplo</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }
    {
      c.midia === 'numeros' && (
        <dl class="destaque nums">
          {numeros.map((n) => (
            <div data-fade>
              <dt>{n.v}</dt>
              <dd>{n.r}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <section class="bloco" aria-labelledby="h-problema">
      <h2 id="h-problema" class="rot">Problema</h2>
      <p class="texto" data-fade>{problema}</p>
    </section>

    <section class="bloco" aria-labelledby="h-solucao">
      <h2 id="h-solucao" class="rot">Solução</h2>
      <div data-fade>
        <p class="texto">{solucao}</p>
        {
          ehMcp && (
            <ul class="chips" aria-label="As 8 ferramentas do servidor">
              {ferramentasMcp.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )
        }
        {curto?.stack && <p class="stack">{curto.stack}</p>}
        {curto?.nota && <p class="stack">{curto.nota}</p>}
      </div>
    </section>

    <section class="bloco" aria-labelledby="h-rastro">
      <h2 id="h-rastro" class="rot">{ehMcp ? 'Uma execução real' : 'Como funciona'}</h2>
      <div>
        <Trace passos={passos} />
      </div>
    </section>

    {
      ehMcp && (
        <section class="bloco" aria-labelledby="h-correcoes">
          <h2 id="h-correcoes" class="rot">Avaliação e correções</h2>
          <div>
            <p class="texto" data-fade>
              Duas rodadas de teste acharam erros que a resposta certa escondia. Cada um virou uma correção com teste.
            </p>
            <ol class="correcoes">
              {mcp.correcoes!.map((k, n) => (
                <li class="correcao" data-fade style={`--d:${n * 120}ms`}>
                  <h3>{k.rotulo}</h3>
                  <dl>
                    <div class="falhou">
                      <dt>✗ falhou</dt>
                      <dd>{k.falhou}</dd>
                    </div>
                    <div>
                      <dt>causa</dt>
                      <dd>{k.causa}</dd>
                    </div>
                    <div>
                      <dt>ajuste</dt>
                      <dd>{k.ajuste}</dd>
                    </div>
                    <div class="passou">
                      <dt>✓ passou</dt>
                      <dd>{k.passou}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
    {
      ehMcp && (
        <section class="bloco" aria-labelledby="h-seguranca">
          <h2 id="h-seguranca" class="rot">Segurança</h2>
          <ul class="lista" data-fade>
            {mcp.seguranca!.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      slug === cardapio.slug && (
        <section class="bloco" aria-labelledby="h-avaliacao">
          <h2 id="h-avaliacao" class="rot">Avaliação</h2>
          <div>
            <p class="texto" data-fade>
              A métrica principal é o <strong>erro de preço silencioso</strong>: o preço errado que o modelo não marcou para
              revisão. É o erro que chega ao cliente sem ninguém ver.
            </p>
            <dl class="aval" data-fade>
              <div>
                <dt>{av.cardapios}</dt>
                <dd>cardápios sintéticos com gabarito exato</dd>
              </div>
              <div>
                <dt>{av.itens}</dt>
                <dd>itens no gabarito</dd>
              </div>
              <div>
                <dt>{av.estilos.length}</dt>
                <dd>estilos visuais: {av.estilos.join(', ')}</dd>
              </div>
              <div>
                <dt>{av.niveisFoto}</dt>
                <dd>níveis de qualidade de foto</dd>
              </div>
            </dl>
            <h3 class="sub">Armadilhas plantadas</h3>
            <ul class="barras" data-fade>
              {av.armadilhas.map((a) => (
                <li style={`--w:${a.n / Math.max(...av.armadilhas.map((x) => x.n))}`}>
                  <span class="n">{a.n}</span>
                  <span class="r">{a.rotulo}</span>
                  <i aria-hidden="true" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
    {
      slug === cardapio.slug && (
        <section class="bloco" aria-labelledby="h-preliminar">
          <h2 id="h-preliminar" class="rot">Resultado preliminar</h2>
          <div data-fade>
            <p class="texto">
              Em {av.preliminar.cardapios} cardápios: {av.preliminar.limpas}. Na foto difícil, o modelo leu dois preços errado e
              não pediu revisão:
            </p>
            <ul class="erros">
              {av.preliminar.erros.map((e) => (
                <li>
                  <span class="certo">R$ {e.certo}</span>
                  <span aria-hidden="true">→</span>
                  <span class="lido">lido como {e.lido}</span>
                </li>
              ))}
            </ul>
            <p class="todo-linha">TODO: atualizar com a rodada completa de 60 cardápios.</p>
          </div>
        </section>
      )
    }

    <nav class="proximo" aria-label="Próximo projeto" style={`--cor:var(--c-${proximo.cor})`}>
      <span class="k">próximo projeto</span>
      <a href={`/projetos/${proximo.slug}/`}>
        {proximo.nome} <span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Base>

<script>
  import '../../lib/motion-client';
</script>

<style>
  .pg {
    width: 100%;
    max-width: calc(72rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: 1.5rem var(--gutter) 4rem;
  }
  .barra {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .barra a {
    text-decoration: none;
    padding-block: 0.75rem;
  }
  .barra a:hover {
    color: var(--cor);
  }
  .cab {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.5rem;
    align-items: end;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
  }
  .num {
    margin: 0;
    font-size: clamp(4rem, 12vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cor);
    font-variation-settings: 'opsz' 72;
  }
  .status {
    margin: 0 0 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 72;
  }
  .lead {
    grid-column: 1 / -1;
    max-width: 44rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .acoes {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    background: var(--cor);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .link:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--cor) 85%, white);
  }

  /* Mídia de destaque: em largura total, com o contorno claro dos cartões. */
  .destaque {
    margin: 0 0 clamp(3rem, 8vw, 6rem);
  }
  .video video,
  .moldura {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(1.25rem, 3vw, 2.5rem);
    border: 2px solid var(--ink-soft);
    background: #000;
    overflow: hidden;
  }
  .moldura {
    background: var(--surface);
  }
  figcaption {
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .galeria {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .galeria figure {
    margin: 0;
  }
  .galeria :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    border: 2px solid var(--ink-soft);
  }
  .nums {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--ink-soft);
    border-radius: clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
  }
  .nums div {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--rule);
    margin: -1px 0 0 -1px;
  }
  .nums dt {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--cor);
  }
  .nums dd {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  /* Blocos: rótulo à esquerda, conteúdo à direita, separados por um fio. */
  .bloco {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }
  .rot {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor);
  }
  .texto {
    margin: 0;
    max-width: 44rem;
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.55;
  }
  .chips {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips li {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .stack {
    margin: 1rem 0 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .correcoes {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .correcao {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 2px solid var(--ink-soft);
    border-radius: clamp(1.25rem, 2.5vw, 2rem);
  }
  .correcao h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
  }
  .correcao dl {
    margin: 0;
    display: grid;
    gap: 0.875rem;
  }
  .correcao dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }
  .correcao dd {
    margin: 0.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .falhou dt {
    color: var(--c-coral);
  }
  .passou dt {
    color: var(--c-verde);
  }
  .lista {
    margin: 0;
    padding-left: 1.25rem;
    max-width: 44rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .lista li + li {
    margin-top: 0.5rem;
  }
  .aval {
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }
  .aval div {
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }
  .aval dt {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--cor);
  }
  .aval dd {
    margin: 0.375rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .sub {
    margin: 2rem 0 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }
  /* Armadilhas como barras proporcionais à quantidade. */
  .barras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .barras li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-areas: 'n r' 'n bar';
    column-gap: 0.75rem;
    align-items: center;
  }
  .barras .n {
    grid-area: n;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--cor);
  }
  .barras .r {
    grid-area: r;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .barras i {
    grid-area: bar;
    display: block;
    height: 6px;
    margin-top: 0.375rem;
    border-radius: 999px;
    background: var(--cor);
    width: calc(var(--w) * 100%);
  }
  .erros {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .erros li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.75rem 1.125rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.875rem;
  }
  .lido {
    color: var(--cor);
  }
  .todo-linha {
    margin: 1.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .proximo {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 2px solid var(--ink-soft);
    border-radius: clamp(1.5rem, 3.5vw, 3rem);
  }
  .proximo .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor);
  }
  .proximo a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .proximo a:hover {
    color: var(--cor);
  }

  @media (min-width: 900px) {
    .bloco {
      grid-template-columns: 14rem 1fr;
      gap: 2.5rem;
    }
    .rot {
      padding-top: 0.375rem;
    }
    .galeria {
      grid-template-columns: repeat(3, 1fr);
    }
    .nums {
      grid-template-columns: repeat(4, 1fr);
    }
    .aval {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
