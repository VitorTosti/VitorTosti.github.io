---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import CitySimulator from '../../components/CitySimulator.astro';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entre vias — laboratório de mobilidade · Vitor Tosti</title>
    <meta name="description" content="Uma cidade, outras escolhas. Experimente demanda, ônibus e semáforos em um simulador interativo de mobilidade urbana." />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body><CitySimulator /></body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #101f2a; color: #eef0eb; font-family: Arial, Helvetica, sans-serif; }
  button, input, select { font: inherit; }
  button, a, input, summary { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid #eead67; outline-offset: 4px; }
  ::selection { background: #f0ad66; color: #101f2a; }
  a { color: inherit; text-underline-offset: .25em; }
  button { cursor: pointer; }
  [hidden] { display: none !important; }
  html { scrollbar-color: #67828e #101f2a; }
</style>
