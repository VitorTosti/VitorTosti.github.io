---
// English version: a compact, content-first page with the same facts as the Portuguese site.
import Base from '../../layouts/Base.astro';
import BigTitle from '../../components/BigTitle.astro';
import Stack from '../../components/Stack.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import { en as t } from '../../i18n/en';
import { CURRICULO, temCurriculo } from '../../lib/curriculo';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
---

<Base
  lang="en"
  title={t.meta.title}
  description={t.meta.description}
  pessoa
  alternates={{ 'pt-BR': '/', en: '/en/' }}
>
  <header class="top wide">
    <nav aria-label="Sections">
      {t.nav.map((l) => <a href={l.href}>{l.rotulo}</a>)}
    </nav>
    <p class="label">{t.subtitle}</p>
    <h1>{t.h1}</h1>
    <p class="intro">{t.intro}</p>
    <div class="botoes">
      <a class="pill" href="#projects">{t.cta.projects}</a>
      <a class="ghost" href="/projetos/entrevias/">{t.cta.city}</a>
      {temCurriculo && <a class="ghost" href={CURRICULO} download>{t.cta.cv}</a>}
      <a class="ghost" href="#contact">{t.cta.contact}</a>
    </div>
    <ul class="nums">
      {t.numbers.map((n) => <li><strong>{n.v}</strong><span>{n.r}</span></li>)}
    </ul>
  </header>

  <section class="section wide" id="projects">
    <BigTitle text={t.projectsTitle} />
    <p class="nota">{t.projectsNote}</p>
    <div class="cards">
      {
        t.projects.map((p) => (
          <article class="card" data-fade>
            <p class="status">{p.status}</p>
            <h3>{p.nome}</h3>
            <dl>
              <dt>Problem</dt>
              <dd>{p.problem}</dd>
              <dt>Solution</dt>
              <dd>{p.solution}</dd>
              <dt>Results</dt>
              <dd>
                <ul>{p.results.map((r) => <li>{r}</li>)}</ul>
              </dd>
            </dl>
            <p class="links">
              {p.link && <a class="ghost" href={p.link.href}>{p.link.rotulo} <span aria-hidden="true">↗</span></a>}
              <a class="ghost" href={`/projetos/${p.slug}/`} hreflang="pt-BR">{t.details}</a>
            </p>
          </article>
        ))
      }
    </div>
    <aside class="city" data-fade>
      <h3>{t.cityTitle}</h3>
      <p>{t.cityText}</p>
      <a class="pill" href="/projetos/entrevias/">{t.cta.city}</a>
    </aside>
  </section>

  <Stack en />

  <section class="section col about" id="about">
    <BigTitle text={t.aboutTitle} />
    <p class="texto">{t.about}</p>
  </section>

  <section class="section wide" id="experience">
    <BigTitle text={t.experienceTitle} />
    <div class="cols">
      <ol class="tl">
        {
          t.experience.map((e) => (
            <li data-fade>
              <p class="quando">{e.quando}</p>
              <h3>{e.onde} <span class="papel">· {e.papel}</span></h3>
              <p>{e.texto}</p>
            </li>
          ))
        }
      </ol>
      <div>
        <h3 class="sub">Education</h3>
        <ul class="edu">
          {t.education.map((f) => <li><span><strong>{f.onde}</strong> · {f.texto}</span><span class="quando">{f.quando}</span></li>)}
          <li><span>{t.languages}</span></li>
        </ul>
      </div>
    </div>
  </section>

  <Depoimentos en />

  <section class="section contato" id="contact">
    <BigTitle text={t.contactTitle} />
    <p class="frase">{t.contact}</p>
    <a class="pill grande" href={`mailto:${t.links.email}`}>{t.links.email}</a>
    <ul class="links2">
      <li><a class="ghost" href={t.links.github} rel="me">GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a class="ghost" href={t.links.linkedin} rel="me">LinkedIn <span aria-hidden="true">↗</span></a></li>
    </ul>
    <form class="form" data-form data-endpoint={endpoint ?? ''} data-email={t.links.email}>
      <h3 class="form-t">{t.form.titulo}</h3>
      <label>{t.form.nome}<input name="nome" required autocomplete="name" /></label>
      <label>{t.form.email}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{t.form.mensagem}<textarea name="mensagem" rows="4" required></textarea></label>
      <input name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="mel" />
      <button class="pill" type="submit">{t.form.enviar}</button>
      <p class="form-s" role="status" aria-live="polite"></p>
    </form>
    <p class="rodape">© {new Date().getFullYear()} Vitor Tosti · built with Astro</p>
  </section>
</Base>

<script>
  import '../../lib/motion-client';
  import { iniciarFormulario } from '../../lib/formulario';
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((f) => iniciarFormulario(f, 'en'));
</script>

<style>
  .top { padding-top: 6rem; padding-bottom: 3rem; display: grid; gap: 1.5rem; }
  .top nav { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 2rem; }
  .top nav a { font-family: var(--mono); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; padding-block: 0.75rem; }
  h1 { margin: 0; font-weight: 400; font-size: clamp(2.5rem, 7vw, 5rem); line-height: 1.02; letter-spacing: -0.025em; max-width: 18ch; }
  .intro { margin: 0; max-width: 40rem; font-size: clamp(1.125rem, 2vw, 1.375rem); color: var(--ink-2); }
  .botoes { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nums { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
  .nums li { display: grid; gap: 0.35rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .nums strong { font-family: var(--mono); font-size: 1.5rem; color: var(--accent-text); font-weight: 600; }
  .nums span { color: var(--ink-2); font-size: 0.9375rem; }
  .nota { text-align: center; color: var(--ink-2); font-family: var(--mono); font-size: 0.8125rem; margin: 1rem 0 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .card { padding: 1.75rem; border: 1px solid var(--rule); border-radius: 1.5rem; background: var(--surface); display: grid; gap: 1rem; align-content: start; }
  .status { margin: 0; font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-text); }
  .card h3 { margin: 0; font-weight: 400; font-size: 1.75rem; }
  dl { margin: 0; display: grid; gap: 0.35rem; }
  dt { font-family: var(--mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-2); margin-top: 0.6rem; }
  dd { margin: 0; line-height: 1.5; }
  dd ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .links { margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .city { margin-top: 2rem; padding: 2rem; border-radius: 1.5rem; border: 1px solid var(--accent); display: grid; gap: 1rem; justify-items: start; }
  .city h3 { margin: 0; font-weight: 400; font-size: 1.75rem; }
  .city p { margin: 0; max-width: 40rem; color: var(--ink-2); }
  .about { display: grid; justify-items: center; text-align: center; }
  .texto { margin: 2rem 0 0; font-size: clamp(1.25rem, 2.2vw, 1.625rem); line-height: 1.5; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; margin-top: 2rem; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
  .tl { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .tl h3 { margin: 0.25rem 0; font-weight: 500; font-size: 1.375rem; }
  .tl p { margin: 0; }
  .papel { color: var(--ink-2); font-weight: 400; }
  .quando { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); }
  .sub { margin: 0 0 1rem; font-weight: 500; font-size: 1.375rem; }
  .edu { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .edu li { display: grid; gap: 0.15rem; }
  .contato { display: grid; justify-items: center; text-align: center; gap: 2rem; padding-inline: var(--gutter); }
  .frase { margin: 0; max-width: 34rem; font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.45; color: var(--ink-2); }
  .links2 { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .form { width: min(100%, 34rem); display: grid; gap: 1rem; text-align: left; padding: 1.5rem; border: 1px solid var(--rule); border-radius: 1.25rem; background: var(--surface); }
  .form-t { margin: 0; font-size: 1.25rem; font-weight: 500; }
  .form label { display: grid; gap: 0.35rem; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .form input, .form textarea { font: inherit; font-family: var(--serif); font-size: 1.0625rem; text-transform: none; letter-spacing: 0; color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 0.6rem; padding: 0.7rem 0.85rem; min-height: 44px; }
  .form input:focus-visible, .form textarea:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .form .mel { position: absolute; left: -9999px; }
  .form .pill { justify-self: start; border: 0; cursor: pointer; }
  .form-s { margin: 0; min-height: 1.4em; font-size: 0.9375rem; color: var(--ink-2); }
  .rodape { margin: 4rem 0 0; font-family: var(--mono); font-size: 0.75rem; color: var(--ink-2); }
</style>
