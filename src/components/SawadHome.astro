---
import { Image } from 'astro:assets';
import portrait from '../assets/vitor-sawad-editorial.png';
import caij from '../assets/caij-fluxo.webp';
import mcp from '../assets/mcp-poster.webp';
import kairo from '../assets/kairo-painel-hoje.webp';
import { ptBR as s } from '../i18n/pt-BR';
import { notas, formatarData } from '../lib/notas';
import { CURRICULO, temCurriculo } from '../lib/curriculo';
import { siGit, siModelcontextprotocol, siPostgresql, siPython, siReact, siTypescript } from 'simple-icons';

interface Props { en?: boolean }
const { en = false } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;

const projects = [
  { name: 'InfoCAIJ', type: en ? 'Internal operations platform' : 'Plataforma de operação interna', href: '/projetos/infocaij/', image: caij, alt: 'Painel operacional do InfoCAIJ', tone: '#116a71' },
  { name: 'InfoCAIJ MCP', type: en ? 'AI over real data' : 'IA sobre dados reais', href: '/projetos/infocaij-mcp/', image: mcp, alt: 'Demonstração do InfoCAIJ MCP', tone: '#6b44a6' },
  { name: 'Kairo', type: en ? 'Scheduling product' : 'Produto de agendamento', href: '/projetos/kairo/', image: kairo, alt: 'Painel de agenda do Kairo', tone: '#f3793a' },
];
const experience = en ? [
  { name: 'CAIJ Informática', role: 'Technology Technician', text: 'InfoCAIJ, InfoMachine, and installation automation with FOG.', date: 'Feb 2026 – Present' },
  { name: 'Genesis Development & Equipment', role: 'Engineering Intern', text: 'Automated automotive lighting tests and a management dashboard.', date: 'Sep 2025 – Feb 2026' },
  { name: 'Mercedes-Benz do Brasil', role: 'Apprentice', text: 'CNC machine programming and operation.', date: 'Jan 2025 – Aug 2025' },
] : [
  { name: s.trajetoria[0].onde, role: s.trajetoria[0].papel, text: 'InfoCAIJ, InfoMachine e automação de instalação com FOG.', date: s.trajetoria[0].quando },
  { name: s.trajetoria[1].onde, role: s.trajetoria[1].papel, text: 'Testes automatizados de iluminação automotiva e dashboard para a gerência.', date: s.trajetoria[1].quando },
  { name: s.trajetoria[2].onde, role: s.trajetoria[2].papel, text: s.trajetoria[2].texto, date: s.trajetoria[2].quando },
];
const noteEnglish: Record<string, { title: string; summary: string }> = {
  'mediana-esconde-gargalo': { title: 'When the median hides the bottleneck', summary: 'The MCP server pointed to the wrong bottleneck because I ranked stages by median time. The long tail was elsewhere.' },
  'quem-escreve-nao-revisa': { title: 'The author should not be the reviewer', summary: 'Five rules that helped a team of AI agents deliver Kairo without stepping on each other’s code.' },
};
const tools = [
  { icon: siPython, name: 'Python', detail: en ? 'Automation & AI' : 'Automação e IA', color: '#3474a5' },
  { icon: siTypescript, name: 'TypeScript', detail: en ? 'Applications & MCP' : 'Aplicações e MCP', color: '#3178c6' },
  { icon: siPostgresql, name: 'PostgreSQL', detail: en ? 'Data & queries' : 'Dados e consultas', color: '#336791' },
  { icon: siModelcontextprotocol, name: 'MCP', detail: en ? 'AI tools' : 'Ferramentas de IA', color: '#171717' },
  { icon: siReact, name: 'React', detail: en ? 'Interfaces' : 'Interfaces', color: '#52c4e5' },
  { icon: siGit, name: 'Git', detail: en ? 'Version control' : 'Versionamento', color: '#aa3214' },
];
---

<div class="sawad-home" data-sawad-home>
  <nav class="icon-nav" aria-label={en ? 'Main navigation' : 'Navegação principal'}>
    <a href="#inicio" aria-label={en ? 'Home' : 'Início'} title={en ? 'Home' : 'Início'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="M9 21v-8h6v8"/></svg></a>
    <a href="#projetos" aria-label={en ? 'Projects' : 'Projetos'} title={en ? 'Projects' : 'Projetos'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg></a>
    <a href="#experiencia" aria-label={en ? 'Experience' : 'Experiência'} title={en ? 'Experience' : 'Experiência'}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18M12 13v3"/></svg></a>
    <a href="#ferramentas" aria-label={en ? 'Tools' : 'Ferramentas'} title={en ? 'Tools' : 'Ferramentas'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4.5 4.5 0 0 0-5.9 5.9L3 18a2 2 0 0 0 3 3l5.8-5.8a4.5 4.5 0 0 0 5.9-5.9l-3.1 3.1-3-3Z"/></svg></a>
    <a href="#notas" aria-label={en ? 'Notes' : 'Notas'} title={en ? 'Notes' : 'Notas'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6"/><path d="m16 4 4 4-9 9-4 1 1-4Z"/></svg></a>
  </nav>

  <div class="page-grid" id="inicio">
    <aside class="profile-wrap">
      <div class="profile-card" data-reveal>
        <div class="portrait-box"><Image src={portrait} alt={en ? 'Editorial portrait of Vitor Tosti' : 'Retrato editorial de Vitor Tosti'} width={520} height={650} loading="eager" fetchpriority="high" /></div>
        <svg class="profile-path path-top" viewBox="0 0 330 90" aria-hidden="true"><path d="M-24 0C17 96 125 107 160-20"/></svg>
        <h2>Vitor Tosti</h2>
        <div class="orbit" aria-hidden="true"><span>✦</span></div>
        <svg class="profile-path path-bottom" viewBox="0 0 330 120" aria-hidden="true"><path d="M-20 112C65 100 96 73 113 0"/></svg>
        <p>{en ? 'Software developer building useful systems and applied AI.' : 'Desenvolvedor de software e IA aplicada para problemas reais.'}</p>
        <div class="socials">
          <a href={s.links.github} aria-label="GitHub" title="GitHub" rel="me">GH</a>
          <a href={s.links.linkedin} aria-label="LinkedIn" title="LinkedIn" rel="me">in</a>
          <a href={`mailto:${s.links.email}`} aria-label={en ? 'Email' : 'E-mail'} title={en ? 'Email' : 'E-mail'}>@</a>
          {temCurriculo && <a href={CURRICULO} download aria-label={en ? 'Download résumé' : 'Baixar currículo'} title={en ? 'Résumé' : 'Currículo'}>↓</a>}
        </div>
      </div>
    </aside>

    <div class="content-column">
      <section class="hero-block" aria-labelledby="hero-title">
        <h1 id="hero-title" data-reveal>{en ? <>SOFTWARE <span>DEVELOPER</span></> : <>DESENVOLVEDOR <span>DE SOFTWARE</span></>}</h1>
        <p class="hero-intro" data-reveal>{en ? 'I study Computer Science at UFABC and enjoy turning ideas into clear, useful digital products. I combine software development and applied AI to build tools that work for the people using them every day.' : 'Sou estudante de Ciência da Computação na UFABC e gosto de transformar ideias em produtos digitais claros e úteis. Combino desenvolvimento e IA aplicada para criar ferramentas que funcionam no dia a dia.'}</p>
        <div class="feature-cards" data-reveal>
          <a class="feature-card orange" href="/projetos/infocaij/">
            <span class="feature-icon" aria-hidden="true">▱</span><strong>{en ? <>SOFTWARE IN<br />PRODUCTION</> : <>SISTEMAS EM<br />PRODUÇÃO</>}</strong><span class="feature-arrow" aria-hidden="true">→</span>
          </a>
          <a class="feature-card lime" href="/projetos/infocaij-mcp/">
            <span class="feature-icon" aria-hidden="true">⌘</span><strong>{en ? <>AI ON REAL<br />DATA</> : <>IA APLICADA A<br />DADOS REAIS</>}</strong><span class="feature-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="content-section projects-section" id="projetos" aria-labelledby="projects-title">
        <h2 class="split-title" id="projects-title" data-reveal>{en ? <>RECENT <span>PROJECTS</span></> : <>PROJETOS <span>RECENTES</span></>}</h2>
        <div class="project-list">
          {projects.map((project, index) => <a class="project-item" href={project.href} data-reveal>
            <span class="project-thumb" style={`--thumb-bg:${project.tone}`}><span class="thumb-index" aria-hidden="true">0{index + 1}</span><Image src={project.image} alt={project.alt} widths={[320, 480, 640]} sizes="(max-width: 540px) 125px, 165px" loading="lazy" /></span>
            <span class="project-text"><strong>{project.name}</strong><small>{project.type}</small></span>
            <span class="item-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
        <a class="section-more" href="/projetos/" hreflang="pt-BR">{en ? 'All projects' : 'Todos os projetos'} ↗</a>
      </section>

      <section class="content-section experience-section" id="experiencia" aria-labelledby="experience-title">
        <h2 class="split-title" id="experience-title" data-reveal>{en ? <>WORK <span>EXPERIENCE</span></> : <>MINHA <span>EXPERIÊNCIA</span></>}</h2>
        <div class="experience-list">
          {experience.map((job) => <article class="experience-item" data-reveal>
            <div><h3>{job.name}</h3><p class="job-role">{job.role}</p><p class="job-text">{job.text}</p><time>{job.date}</time></div>
            <span class="item-arrow" aria-hidden="true">↗</span>
          </article>)}
        </div>
      </section>

      <section class="content-section tools-section" id="ferramentas" aria-labelledby="tools-title">
        <h2 class="split-title" id="tools-title" data-reveal>{en ? <>CORE <span>TOOLS</span></> : <>MINHAS <span>FERRAMENTAS</span></>}</h2>
        <div class="tools-grid">
          {tools.map((tool) => <div class="tool-item" data-reveal><span class="tool-icon" style={`--tool-color:${tool.color}`} aria-hidden="true"><svg viewBox="0 0 24 24"><path d={tool.icon.path} /></svg></span><span><strong>{tool.name}</strong><small>{tool.detail}</small></span></div>)}
        </div>
      </section>

      <section class="content-section notes-section" id="notas" aria-labelledby="notes-title">
        <h2 class="split-title" id="notes-title" data-reveal>{en ? <>TECH <span>NOTES</span></> : <>NOTAS <span>TÉCNICAS</span></>}</h2>
        <div class="notes-list">
          {notas.map((note) => <a href={`/notas/${note.slug}/`} hreflang={en ? 'pt-BR' : undefined} class="note-item" data-reveal><strong>{en ? noteEnglish[note.slug]?.title ?? note.titulo : note.titulo}</strong><span class="item-arrow" aria-hidden="true">↗</span><p>{en ? noteEnglish[note.slug]?.summary ?? note.resumo : note.resumo}</p><time datetime={note.data}>{formatarData(note.data)}</time></a>)}
        </div>
      </section>

      <section class="content-section contact-section" id="contato" aria-labelledby="contact-title">
        <h2 class="split-title" id="contact-title" data-reveal>{en ? <>LET'S WORK <span>TOGETHER</span></> : <>VAMOS <span>CONVERSAR</span></>}</h2>
        <p class="contact-intro">{en ? 'Have a real problem to solve? Tell me about it.' : 'Tem um problema real para resolver? Conte-me sobre ele.'}</p>
        <form class="contact-form" data-form data-endpoint={endpoint ?? ''} data-email={s.links.email}>
          <div class="form-row"><label>{en ? 'Name' : 'Nome'}<input name="nome" required autocomplete="name" placeholder={en ? 'Your name' : 'Seu nome'} /></label><label>{en ? 'Email' : 'E-mail'}<input name="email" type="email" required autocomplete="email" placeholder="voce@email.com" /></label></div>
          <label>{en ? 'Message' : 'Mensagem'}<textarea name="mensagem" rows="5" required placeholder={en ? 'Tell me about your project' : 'Conte-me sobre o projeto'}></textarea></label>
          <input name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
          <button type="submit">{en ? 'Send message' : 'Enviar mensagem'} <span aria-hidden="true">↗</span></button>
          <p class="form-s" role="status" aria-live="polite"></p>
        </form>
        <div class="contact-bottom"><a href={`mailto:${s.links.email}`}>{s.links.email}</a><span>© {new Date().getFullYear()} Vitor Tosti</span></div>
      </section>
    </div>
  </div>
</div>

<style>
  .sawad-home { --orange: #ff6a32; --lime: #bcff3e; min-height: 100vh; overflow: clip; background: #151313; color: #fff; font-family: 'DM Sans', Arial, sans-serif; }
  .icon-nav { display: flex; align-items: center; justify-content: center; gap: 1.5rem; width: max-content; margin: 30px auto 0; padding: .75rem 1.25rem; border-radius: 18px; background: #1e1c1c; position: relative; z-index: 3; }
  .icon-nav a { display: grid; place-items: center; width: 28px; height: 28px; color: #fff; transition: color .2s ease, transform .2s ease; }
  .icon-nav a:hover, .icon-nav a:focus-visible { color: var(--orange); transform: translateY(-3px); }
  .icon-nav svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .page-grid { width: min(calc(100% - 40px), 1140px); margin: 82px auto 0; display: grid; grid-template-columns: 345px minmax(0, 1fr); gap: 100px; align-items: start; }
  .profile-wrap { position: sticky; top: 40px; align-self: start; }
  .profile-card { height: 640px; padding: 30px 24px 28px; border-radius: 16px; background: #fafafa; color: #090909; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .portrait-box { width: 240px; height: 284px; border-radius: 15px; overflow: hidden; background: #e74605; position: relative; z-index: 1; flex: none; }
  .portrait-box :global(img) { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 29%; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .profile-card:hover .portrait-box :global(img) { transform: scale(1.05); }
  .profile-path { position: absolute; width: 330px; height: auto; pointer-events: none; }
  .profile-path path { fill: none; stroke: #ff7500; stroke-width: 3; stroke-dasharray: 8 8; animation: dash 16s linear infinite; }
  .path-top { top: -11px; left: 0; z-index: 2; }
  .path-bottom { top: 377px; left: 0; }
  .profile-card h2 { position: relative; z-index: 1; font-size: 2.2rem; font-weight: 900; letter-spacing: -.055em; line-height: 1; margin: 24px 0 0; white-space: nowrap; }
  .orbit { width: 36px; height: 36px; display: grid; place-items: center; margin-top: 20px; border-radius: 50%; background: #ff7500; color: #fff; font-size: 1.25rem; position: relative; z-index: 2; }
  .orbit span { animation: pulse 3s ease-in-out infinite; }
  .profile-card p { color: #666; max-width: 270px; margin: auto 0 0; font-size: 1.08rem; font-weight: 700; line-height: 1.18; }
  .socials { display: flex; gap: 24px; justify-content: center; margin-top: 34px; }
  .socials a { color: #c64714; font-size: 1.18rem; font-weight: 900; line-height: 1; text-decoration: none; transition: transform .2s ease, color .2s ease; }
  .socials a:hover { color: #d84d1b; transform: translateY(-3px); }
  .content-column { min-width: 0; }
  .hero-block { padding-top: 5px; }
  .hero-block h1, .split-title { margin: 0; font-family: 'DM Sans', Arial, sans-serif; font-size: clamp(3.4rem, 6.7vw, 6.55rem); font-weight: 900; line-height: .98; letter-spacing: -.075em; text-transform: uppercase; }
  .hero-block h1 span, .split-title span { display: block; color: #696666; }
  .hero-intro { max-width: 580px; margin: 30px 0 0; color: #aaa6a6; font-size: 1.17rem; line-height: 1.5; }
  .feature-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: clamp(65px, 8vw, 115px); }
  .feature-card { min-height: 212px; border-radius: 12px; padding: 22px 20px; position: relative; overflow: hidden; color: #fff; text-align: left; text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease; }
  .feature-card:hover { transform: translateY(-7px); box-shadow: 0 16px 35px rgb(0 0 0 / .22); }
  .feature-card.orange { background: #f86b37; }
  .feature-card.lime { background: var(--lime); color: #101010; }
  .feature-card::before { content: ''; position: absolute; inset: 0; opacity: .17; background: repeating-linear-gradient(145deg, transparent 0 52px, currentColor 54px 58px, transparent 61px 120px); transform: scale(1.5) rotate(-10deg); transition: transform .5s ease; }
  .feature-card:hover::before { transform: scale(1.65) rotate(0); }
  .feature-icon, .feature-card strong, .feature-arrow { position: relative; z-index: 1; }
  .feature-icon { font-size: 2.5rem; line-height: 1; }
  .feature-card strong { font-size: 1.32rem; line-height: 1.08; font-weight: 800; letter-spacing: -.025em; }
  .feature-arrow { position: absolute; right: 17px; bottom: 17px; width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid currentColor; border-radius: 5px; font-size: 1.2rem; transition: translate .2s ease; }
  .feature-card:hover .feature-arrow { translate: 3px 0; }
  .content-section { padding-top: 128px; scroll-margin-top: 35px; }
  .split-title { font-size: clamp(3.4rem, 6vw, 5.5rem); max-width: 100%; }
  .project-list { display: grid; gap: 20px; margin-top: 35px; }
  .project-item { min-height: 132px; display: grid; grid-template-columns: 165px 1fr 22px; align-items: center; gap: 22px; color: #fff; text-decoration: none; transition: transform .3s ease; }
  .project-item:hover { transform: translateX(6px); }
  .project-thumb { display: block; width: 165px; height: 124px; border-radius: 10px; overflow: hidden; background: radial-gradient(circle at 20% 15%, rgb(255 255 255 / .24), transparent 52%), var(--thumb-bg); position: relative; isolation: isolate; }
  .project-thumb::before { content: ''; position: absolute; width: 140px; aspect-ratio: 1; border: 1px solid rgb(255 255 255 / .28); border-radius: 50%; right: -65px; top: -78px; }
  .project-thumb :global(img) { display: block; position: absolute; width: 144px; height: 92px; max-width: none; left: 25px; bottom: 8px; object-fit: cover; object-position: left top; border: 1px solid rgb(255 255 255 / .3); border-radius: 5px; box-shadow: 0 9px 20px rgb(0 0 0 / .4); transform: rotate(-4deg); transition: transform .35s ease, box-shadow .35s ease; }
  .project-item:hover .project-thumb :global(img) { transform: rotate(0) translate(-5px, -5px) scale(1.07); box-shadow: 0 14px 25px rgb(0 0 0 / .5); }
  .thumb-index { position: absolute; z-index: 1; top: 9px; left: 11px; color: #fff; font: 800 .72rem/1 'DM Sans', Arial, sans-serif; letter-spacing: .04em; }
  .project-text { display: grid; gap: 5px; }
  .project-text strong { font-size: 1.55rem; font-weight: 800; letter-spacing: -.04em; }
  .project-text small { color: #969393; font-size: 1.02rem; }
  .item-arrow { align-self: start; color: var(--orange); font-size: 1.1rem; transition: transform .25s ease; }
  .project-item:hover .item-arrow, .note-item:hover .item-arrow { transform: translate(3px, -3px); }
  .section-more { display: inline-block; margin: 26px 0 0 187px; color: var(--orange); font-size: .92rem; font-weight: 700; text-decoration: none; }
  .section-more:hover { text-decoration: underline; }
  .experience-list { display: grid; gap: 26px; margin-top: 42px; }
  .experience-item { display: grid; grid-template-columns: 1fr 22px; gap: 12px; padding: 0 0 8px 16px; border-left: 2px solid #383636; }
  .experience-item h3 { font-size: 1.55rem; line-height: 1.13; font-weight: 800; letter-spacing: -.035em; margin: 0; }
  .job-role { color: #ddd8d8; margin: 6px 0 0; font-size: .94rem; }
  .job-text { color: #969393; font-size: 1rem; line-height: 1.42; margin: 8px 0 0; }
  .experience-item time { display: block; margin-top: 14px; color: #969393; font-size: .88rem; }
  .tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 30px; margin-top: 40px; }
  .tool-item { display: flex; gap: 15px; align-items: center; }
  .tool-icon { flex: none; width: 60px; height: 60px; border-radius: 12px; display: grid; place-items: center; background: #fff; color: var(--tool-color); }
  .tool-icon svg { width: 33px; height: 33px; fill: currentColor; }
  .tool-item > span:last-child { display: grid; gap: 3px; }
  .tool-item strong { font-size: 1.25rem; font-weight: 800; letter-spacing: -.035em; }
  .tool-item small { color: #969393; font-size: .9rem; }
  .notes-list { display: grid; gap: 22px; margin-top: 40px; }
  .note-item { display: grid; grid-template-columns: 1fr 22px; gap: 0 15px; padding-bottom: 20px; border-bottom: 1px solid #343131; color: #fff; text-decoration: none; }
  .note-item strong { font-size: 1.4rem; line-height: 1.25; font-weight: 800; letter-spacing: -.035em; }
  .note-item p { grid-column: 1 / -1; color: #969393; margin: 12px 0; line-height: 1.4; font-size: .98rem; }
  .note-item time { color: #969393; font-size: .83rem; }
  .contact-section { padding-bottom: 90px; }
  .contact-intro { color: #969393; font-size: 1.08rem; margin: 24px 0 0; }
  .contact-form { display: grid; gap: 20px; margin-top: 32px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .contact-form label { display: grid; gap: 8px; font-size: .9rem; font-weight: 700; }
  .contact-form input, .contact-form textarea { width: 100%; border: 1px solid #494545; border-radius: 7px; padding: 13px 15px; background: #201d1d; color: #fff; font: 400 1rem/1.4 'DM Sans', Arial, sans-serif; resize: vertical; }
  .contact-form input:focus, .contact-form textarea:focus { outline: 2px solid var(--orange); outline-offset: 1px; }
  .contact-form .honeypot { position: absolute; left: -9999px; }
  .contact-form button { width: fit-content; min-height: 49px; padding: 12px 20px; border: 0; border-radius: 7px; background: var(--orange); color: #111; font: 800 .88rem/1 'DM Sans', Arial, sans-serif; cursor: pointer; transition: transform .2s ease, background .2s ease; }
  .contact-form button:hover { background: #ff8a5a; transform: translateY(-3px); }
  .contact-form button span { margin-left: 20px; }
  .form-s { color: #969393; margin: 0; min-height: 1.5em; font-size: .9rem; }
  .contact-bottom { border-top: 1px solid #343131; padding-top: 22px; display: flex; justify-content: space-between; gap: 15px; font-size: .83rem; color: #969393; }
  .contact-bottom a { color: var(--orange); text-decoration: none; }
  @keyframes dash { to { stroke-dashoffset: -128; } }
  @keyframes pulse { 50% { transform: scale(1.25) rotate(35deg); } }
  @media (max-width: 1120px) { .page-grid { gap: clamp(35px, 5vw, 75px); grid-template-columns: 320px minmax(0, 1fr); } .profile-card { width: 320px; } .hero-block h1 { font-size: clamp(3.4rem, 6.4vw, 5.8rem); } }
