---
// Erros e correções como rastro: ✗ falhou → causa → ajuste → ✓ passou.
import { linhasCorrecao, type Correcao } from '../lib/trace';

interface Props {
  correcao: Correcao;
  n: number;
}
const { correcao, n } = Astro.props;
const marca = { falhou: '✗ falhou', causa: '→ causa', ajuste: '→ ajuste', passou: '✓ passou' };
---

<article class="fix run">
  <h5 class="fix-label"><span class="n">{String(n).padStart(2, '0')}</span> {correcao.rotulo}</h5>
  <ol class="fix-steps" data-run>
    {
      linhasCorrecao(correcao).map((l, i) => (
        <li class={`fx ${l.etapa}`} data-step data-at={i * 340}>
          <span class="k">{marca[l.etapa]}</span>
          <p>{l.texto}</p>
        </li>
      ))
    }
  </ol>
</article>

<style>
  .fix {
    margin: 0;
  }
  .fix-label {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .n {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    vertical-align: 0.2em;
    margin-right: 0.25rem;
  }
  .fix-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fx {
    position: relative;
    padding: 0 0 1rem 1.25rem;
    border-left: 1px solid var(--rule);
  }
  .fx:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .fx::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.45rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink-2);
  }
  .fx.falhou::before {
    background: var(--ink);
    border-color: var(--ink);
  }
  .fx.passou::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    margin-bottom: 0.125rem;
  }
  .falhou .k {
    color: var(--ink);
    font-weight: 600;
  }
  .passou .k {
    color: var(--accent-text);
    font-weight: 600;
  }
  .fx p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.45;
  }
</style>

<script>
  import '../lib/reveal-client';
</script>
