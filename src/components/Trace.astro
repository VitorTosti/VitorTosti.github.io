---
// Rastro de um projeto contado como uma execução de agente: a pergunta (ou o problema), as chamadas,
// a saída e a avaliação. Cada passo entra ao rolar. A cor vem de --cor.
import type { Passo } from '../lib/trace';

interface Props {
  passos: Passo[];
}
const { passos } = Astro.props;

const args = (a: Record<string, unknown>) =>
  Object.entries(a)
    .map(([k, v]) => `${k}: ${JSON.stringify(v)}`)
    .join(', ');
const temEtapa = passos.some((p) => p.tipo === 'chamada' && p.etapa);
---

<ol class="rastro">
  {
    passos.map((p, i) => (
      <li class:list={['passo', p.tipo]} data-fade style={`--d:${i * 80}ms`}>
        {p.tipo === 'pergunta' && (
          <>
            <span class="k">{p.rotulo ?? 'pergunta'}</span>
            <p class="pergunta">{p.texto}</p>
          </>
        )}
        {p.tipo === 'chamada' && (
          <>
            <span class="k">{p.etapa ? 'etapa' : 'chamada'}</span>
            <code class="call">
              <b>{p.ferramenta}</b>({args(p.args)})
            </code>
            {p.ms !== undefined && <span class="ms">{p.ms} ms</span>}
          </>
        )}
        {p.tipo === 'saida' && (
          <>
            <span class="k">saída</span>
            <p class="saida">{p.texto}</p>
            {p.aviso && <p class="aviso">! {p.aviso}</p>}
          </>
        )}
        {p.tipo === 'avaliacao' && (
          <>
            <span class="k">avaliação</span>
            <ul class="itens">
              {p.itens.map((it) => (
                <li>✓ {it}</li>
              ))}
            </ul>
          </>
        )}
      </li>
    ))
  }
</ol>
{temEtapa && <p class="nota">Etapas com nomes descritivos: mostram o fluxo do sistema, não funções reais.</p>}

<style>
  .rastro {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* A linha do tempo: um fio vertical ligando os passos. */
  .rastro::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--rule);
  }
  .passo {
    position: relative;
    padding: 0 0 1.75rem 2rem;
  }
  .passo::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 999px;
    background: var(--paper);
    border: 2px solid var(--cor, var(--accent));
  }
  .passo.avaliacao::before {
    background: var(--cor, var(--accent));
  }
  .k {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor, var(--accent));
  }
  .pergunta {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.35;
  }
  .call {
    display: inline-block;
    max-width: 100%;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .call b {
    font-weight: 600;
    color: var(--ink);
  }
  .ms {
    margin-left: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .saida {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .aviso {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--cor, var(--accent));
  }
  .itens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .itens li {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .nota {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
  }
</style>
