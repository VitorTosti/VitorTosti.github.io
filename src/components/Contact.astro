---
// Contato: sobe por cima da superfície com cantos arredondados, como o fim de uma página de log.
import BigTitle from './BigTitle.astro';
import { ptBR as s } from '../i18n/pt-BR';
import { CURRICULO, temCurriculo } from '../lib/curriculo';
---

<section class="section contato" id="contato">
  <BigTitle text={s.titulos.contato} />
  <p class="frase" data-fade>{s.contato}</p>
  <a class="pill grande" href={`mailto:${s.links.email}`} data-fade style="--d:120ms">{s.links.email}</a>
  <ul class="links" data-fade style="--d:200ms">
    <li><a class="ghost" href={s.links.github} rel="me">GitHub <span aria-hidden="true">↗</span></a></li>
    <li><a class="ghost" href={s.links.linkedin} rel="me">LinkedIn <span aria-hidden="true">↗</span></a></li>
    {
      temCurriculo && (
        <li>
          <a class="ghost" href={CURRICULO} download>
            {s.curriculo}
          </a>
        </li>
      )
    }
  </ul>
  <p class="rodape">© {new Date().getFullYear()} {s.nome} · feito com Astro, sem rastreamento</p>
</section>

<style>
  .contato {
    position: relative;
    background: var(--paper);
    border-radius: clamp(2rem, 4vw, 3.75rem) clamp(2rem, 4vw, 3.75rem) 0 0;
    margin-top: calc(-1 * clamp(2rem, 4vw, 3.75rem));
    padding-inline: var(--gutter);
    padding-bottom: 2.5rem;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 2rem;
  }
  .frase {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .rodape {
    margin: clamp(3rem, 8vw, 6rem) 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
</style>
