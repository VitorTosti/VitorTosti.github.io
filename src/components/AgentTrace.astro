---
// Um projeto contado como execução de agente: pergunta → chamadas → saída → avaliação.
import { agendaPassos, jsonTokens, validarRastro, type Passo } from '../lib/trace';

interface Props {
  passos: Passo[];
  titulo: string;
  modelo?: string;
}
const { passos, titulo, modelo } = Astro.props;

const erros = validarRastro(passos);
if (erros.length) throw new Error(`rastro "${titulo}" inválido: ${erros.join('; ')}`);

const CHAMADA_MS = 560;
const agenda = agendaPassos(passos.map((p) => p.tipo), 280, CHAMADA_MS);
const chamadas = passos.filter((p) => p.tipo === 'chamada');
const soEtapas = chamadas.every((p) => p.tipo === 'chamada' && p.etapa);
const contagem = soEtapas
  ? `${chamadas.length} ${chamadas.length === 1 ? 'etapa' : 'etapas'} · nomes descritivos`
  : `${chamadas.length} ${chamadas.length === 1 ? 'chamada' : 'chamadas'}`;
const rotulo = (p: Passo) =>
  p.tipo === 'pergunta'
    ? (p.rotulo ?? 'pergunta')
    : p.tipo === 'chamada'
      ? p.etapa
        ? 'etapa'
        : 'ferramenta'
      : p.tipo === 'saida'
        ? 'saída'
        : 'avaliação';
---

<figure class="trace run">
  <figcaption class="trace-head">
    <span>rastro · {titulo}</span>
    <span>{modelo ? `${modelo} · ` : ''}{contagem}</span>
  </figcaption>
  <ol class="steps" data-run>
    {
      passos.map((p, i) => (
        <li class={`step ${p.tipo}`} data-step data-at={agenda[i]} data-call={p.tipo === 'chamada' ? CHAMADA_MS : undefined}>
          <span class="k">{rotulo(p)}</span>
          <div class="body">
            {p.tipo === 'pergunta' && <p class:list={['q', { aspas: !p.rotulo }]}>{p.texto}</p>}
            {p.tipo === 'chamada' && (
              <Fragment>
                <code class="call">
                  <span class="fn">{p.ferramenta}</span>
                  <span class="pont">(</span>
                  {Object.keys(p.args).length > 0 &&
                    jsonTokens(p.args).map((j) => <span class={j.k}>{j.t}</span>)}
                  <span class="pont">)</span>
                </code>
                <span class="state" aria-hidden="true">
                  <span class="wait">executando…</span>
                  <span class="ok">{p.ms != null ? `${p.ms} ms` : 'ok'}</span>
                </span>
              </Fragment>
            )}
            {p.tipo === 'saida' && (
              <Fragment>
                <p class="out">{p.texto}</p>
                {p.aviso && (
                  <p class="aviso">
                    <span class="mono">aviso</span> {p.aviso}
                  </p>
                )}
              </Fragment>
            )}
            {p.tipo === 'avaliacao' && (
              <p class="eval">
                <span class="ck" aria-hidden="true">✓</span> {p.itens.join(' · ')}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style is:global>
  .run [data-step] {
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }
  .gen-on [data-run]:not(.run-done) [data-step]:not(.on) {
    opacity: 0;
    transform: translateY(4px);
  }
</style>

<style>
  .trace {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }
  .trace-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.125rem 1rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }
  .step {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    position: relative;
  }
  .step + .step {
    border-top: 1px dashed var(--rule);
  }
  .k {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }
  .body p {
    margin: 0;
  }
  .q {
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .q.aspas::before {
    content: '“';
  }
  .q.aspas::after {
    content: '”';
  }
  .call {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.6;
    word-break: break-word;
  }
  .fn {
    font-weight: 600;
    transition: color var(--t-base) var(--ease);
  }
  .call .chave {
    color: var(--ink-2);
  }
  .call .pont {
    color: var(--ink-2);
  }
  .state {
    display: inline-block;
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .state .wait {
    display: none;
  }
  .step.chamada.active .fn {
    color: var(--accent-text);
  }
  .step.chamada.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: var(--accent);
  }
  .step.active .state .wait {
    display: inline;
    color: var(--accent-text);
  }
  .step.active .state .ok {
    display: none;
  }
  .out {
    font-size: 1.0625rem;
  }
  .aviso {
    margin-top: 0.5rem !important;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .aviso .mono {
    font-size: 0.6875rem;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    margin-right: 0.25rem;
  }
  .eval {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .ck {
    color: var(--accent-text);
  }

  @media (min-width: 768px) {
    .step {
      grid-template-columns: 7rem 1fr;
      gap: 1rem;
      padding: 0.875rem 1.25rem;
      align-items: baseline;
    }
    .trace-head {
      padding: 0.75rem 1.25rem;
    }
    .call {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import '../lib/reveal-client';
</script>
