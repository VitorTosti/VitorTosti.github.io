---
import { getImage } from 'astro:assets';
import AgentTrace from './AgentTrace.astro';
import FixTrace from './FixTrace.astro';
import { ferramentasMcp, infocaijMcp as p } from '../data/projetos';
import gif from '../assets/mcp-demo.gif';
import posterSrc from '../assets/mcp-poster.webp';
import videoUrl from '../assets/infocaij-mcp-demo.mp4?url';

// Pôster: um quadro do GIF com a resposta na tela (extraído uma vez para mcp-poster.webp).
// O GIF animado fica como alternativa para quem não toca vídeo.
const poster = await getImage({ src: posterSrc, format: 'webp', width: 960, quality: 75 });
---

<article class="proj" id={p.slug} aria-labelledby={`h-${p.slug}`}>
  <header class="col head">
    <p class="label">01 · destaque{p.status && ` · ${p.status}`}</p>
    <h3 id={`h-${p.slug}`}>{p.nome}</h3>
  </header>

  <div class="col prose">
    <p><span class="lbl">Problema.</span> {p.problema}</p>
    <p><span class="lbl">Solução.</span> {p.solucao}</p>
    <ul class="tools" aria-label="As 8 ferramentas do servidor">
      {ferramentasMcp.map((f) => <li>{f}</li>)}
    </ul>
  </div>

  <div class="wide trace-wrap">
    <AgentTrace passos={p.rastro!} titulo={p.slug} modelo="claude" />
  </div>

  <figure class="wide media">
    <video
      controls
      muted
      playsinline
      preload="none"
      poster={poster.src}
      width="1908"
      height="986"
      aria-describedby={`cap-${p.slug}`}
    >
      <source src={videoUrl} type="video/mp4" />
      <img src={gif.src} width={gif.width} height={gif.height} alt="O InfoCAIJ MCP respondendo a perguntas no Claude Desktop." />
    </video>
    <figcaption id={`cap-${p.slug}`} class="label">
      Vídeo de 37 s, sem som: o servidor respondendo no Claude Desktop. Nomes de funcionários borrados.
    </figcaption>
  </figure>

  <section class="wide evals" aria-labelledby={`ev-${p.slug}`}>
    <h4 id={`ev-${p.slug}`} class="sub">Avaliação e correções</h4>
    <p class="intro">
      Duas rodadas de teste acharam erros que a resposta certa escondia. Cada um virou uma correção com teste.
    </p>
    <div class="fixes">
      {p.correcoes!.map((c, i) => <FixTrace correcao={c} n={i + 1} />)}
    </div>
  </section>

  <section class="col sec" aria-labelledby={`sg-${p.slug}`}>
    <h4 id={`sg-${p.slug}`} class="sub">Segurança</h4>
    <ul>
      {p.seguranca!.map((s) => <li>{s}</li>)}
    </ul>
    <p class="link mono">
      <a href={p.link.href}>{p.link.rotulo} ↗</a>
    </p>
  </section>
</article>

<style>
  .proj {
    padding-block: 1rem 3rem;
  }
  .head h3 {
    font-size: clamp(2rem, 7vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .lbl {
    font-style: italic;
    color: var(--ink-2);
  }
  .tools {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tools li {
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-2);
  }
  .trace-wrap {
    margin-top: 2.5rem;
  }
  .media {
    margin-block: 2rem 0;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
  }
  .media figcaption {
    margin-top: 0.625rem;
  }
  .sub {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .evals {
    margin-top: 3.5rem;
  }
  .intro {
    color: var(--ink-2);
    max-width: var(--col);
    margin-bottom: 2rem;
  }
  .fixes {
    display: grid;
    gap: 2.5rem;
  }
  .sec {
    margin-top: 3.5rem;
  }
  .sec ul {
    padding-left: 1.1rem;
    margin: 0 0 1.5rem;
  }
  .sec li {
    margin-bottom: 0.5rem;
  }
  .link {
    font-size: 0.875rem;
  }
  @media (min-width: 900px) {
    .fixes {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  /* Os blocos .col e .wide alinham pela esquerda dentro do .wide do projeto. */
  .col {
    margin-inline: auto;
    max-width: calc(var(--wide) + 2 * var(--gutter));
  }
  .col > * {
    max-width: var(--col);
  }
</style>
