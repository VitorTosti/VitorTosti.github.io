---
// Depois da apresentação, a página segue sozinha para os projetos, com contagem visível e cancelável.
// Transição: a apresentação se apaga token a token, da última palavra para a primeira, como uma
// resposta sendo desfeita; aí os projetos são gerados no lugar.
// Não avança sozinha com movimento reduzido, se a pessoa já interagiu, ou se a página abriu rolada.
import { ptBR as s } from '../i18n/pt-BR';

interface Props {
  /** Seletor do texto gerado cujo fim libera o avanço. */
  depoisDe: string;
  /** id da seção de destino. */
  alvo: string;
}
const { depoisDe, alvo } = Astro.props;
---

<div class="adv" data-adv data-depois={depoisDe} data-alvo={alvo} hidden role="group" aria-label={s.avanco.rotulo}>
  <div class="linha" data-contagem>
    <span class="ask"><span class="pr" aria-hidden="true">›</span> {s.avanco.proximo}</span>
    <span class="em" data-em aria-hidden="true"></span>
    <span class="trk" aria-hidden="true"><i data-barra></i></span>
  </div>
  <div class="acoes">
    <button type="button" class="ir" data-ir>
      <span data-ir-txt>{s.avanco.irAgora}</span>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class="ficar" data-ficar>{s.avanco.ficar}</button>
  </div>
  <p class="sr-only" aria-live="polite" data-aviso></p>
</div>

<style>
  .adv {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    max-width: 30rem;
  }
  .adv[hidden] {
    display: none;
  }
  .linha {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.75rem;
    align-items: center;
  }
  .pr {
    color: var(--accent-text);
    margin-right: 0.25rem;
  }
  .em {
    font-variant-numeric: tabular-nums;
  }
  .trk {
    display: block;
    height: 2px;
    background: var(--rule);
    position: relative;
    overflow: hidden;
  }
  .trk i {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .acoes {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.875rem;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  button:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .ficar {
    color: var(--ink-2);
    border-color: transparent;
  }
  /* Enquanto conta, fica fixa no rodapé da tela: ninguém é levado sem ver a contagem. */
  .adv.flutua {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    z-index: 6;
    width: min(30rem, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 0.75rem 0.875rem;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--ink) 35%, transparent);
    animation: sobe var(--t-base) var(--ease) both;
  }
  @keyframes sobe {
    from {
      opacity: 0;
      transform: translate(-50%, 8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .adv.flutua {
      animation: none;
    }
  }
  /* Sem contagem (cancelada, movimento reduzido ou interação): fica só "ver projetos". */
  .adv.parado .linha,
  .adv.parado .ficar {
    display: none;
  }
</style>

<script>
  import { ptBR as s } from '../i18n/pt-BR';

  const ESPERA = 6000;
  const adv = document.querySelector<HTMLElement>('[data-adv]');
  const fonte = adv && document.querySelector<HTMLElement>(adv.dataset.depois!);
  const alvo = adv && document.getElementById(adv.dataset.alvo!);
  const intro = adv?.closest<HTMLElement>('header, section');

  if (adv && fonte && alvo && intro) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const barra = adv.querySelector<HTMLElement>('[data-barra]')!;
    const em = adv.querySelector<HTMLElement>('[data-em]')!;
    const irTxt = adv.querySelector<HTMLElement>('[data-ir-txt]')!;
    const aviso = adv.querySelector<HTMLElement>('[data-aviso]')!;
    let estado: 'espera' | 'contando' | 'parado' | 'feito' = 'espera';
    let interagiu = scrollY > 40 || location.hash.length > 1;
    let anim: Animation | null = null;
    let relogio = 0;

    function parar() {
      if (estado === 'feito') return;
      estado = 'parado';
      anim?.cancel();
      clearInterval(relogio);
      adv!.classList.remove('flutua');
      adv!.classList.add('parado');
      irTxt.textContent = s.avanco.verProjetos;
      aviso.textContent = '';
    }

    function contar() {
      estado = 'contando';
      adv!.classList.add('flutua');
      const inicio = performance.now();
      em.textContent = s.avanco.em(Math.ceil(ESPERA / 1000));
      aviso.textContent = `${s.avanco.rotulo}: ${s.avanco.em(Math.ceil(ESPERA / 1000))}.`;
      anim = barra.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], { duration: ESPERA, easing: 'linear', fill: 'forwards' });
      relogio = window.setInterval(() => {
        const resta = Math.max(0, Math.ceil((ESPERA - (performance.now() - inicio)) / 1000));
        em.textContent = s.avanco.em(resta);
      }, 250);
      anim.finished.then(() => estado === 'contando' && avancar(), () => {});
    }

    /** Apaga a apresentação token a token, do fim para o começo, e devolve quanto tempo leva. */
    function cortina(): { dur: number; desfazer: () => void } {
      const toks = [...intro!.querySelectorAll<HTMLElement>('.tok')].reverse();
      const resto = [...intro!.querySelectorAll<HTMLElement>('.lens, .info, .meta, .name, .gen-cursor, [data-adv]')];
      const passo = Math.min(9, 900 / Math.max(toks.length, 1));
      const destaque = getComputedStyle(document.documentElement).getPropertyValue('--accent-text').trim();
      const anims: Animation[] = [];
      toks.forEach((t, k) =>
        anims.push(
          t.animate(
            [
              { opacity: 1, color: destaque, offset: 0 },
              { opacity: 1, color: destaque, offset: 0.35 },
              { opacity: 0 },
            ],
            { duration: 140, delay: k * passo, fill: 'forwards', easing: 'ease-out' },
          ),
        ),
      );
      resto.forEach((el) => anims.push(el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 240, fill: 'forwards' })));
      return { dur: toks.length * passo + 160, desfazer: () => anims.forEach((a) => a.cancel()) };
    }

    function chegar() {
      // A contagem já cumpriu o papel; não volta a aparecer.
      adv!.classList.remove('flutua');
      adv!.hidden = true;
      alvo!.setAttribute('tabindex', '-1');
      scrollTo({ top: alvo!.getBoundingClientRect().top + scrollY, behavior: 'instant' as ScrollBehavior });
      alvo!.focus({ preventScroll: true });
    }

    function avancar() {
      if (estado === 'feito') return;
      clearInterval(relogio);
      estado = 'feito';
      aviso.textContent = '';
      if (reduce) {
        chegar();
        return;
      }
      const { dur, desfazer } = cortina();
      setTimeout(() => {
        chegar();
        // A apresentação volta, fora da tela, para quem rolar de volta.
        requestAnimationFrame(desfazer);
      }, dur);
    }

    adv.querySelector('[data-ir]')!.addEventListener('click', avancar);
    adv.querySelector('[data-ficar]')!.addEventListener('click', parar);

    // Qualquer gesto da pessoa fora dos botões cancela o avanço automático.
    const gesto = (e: Event) => {
      if (e.target instanceof Node && adv.contains(e.target)) return;
      interagiu = true;
      if (estado === 'contando') parar();
    };
    for (const tipo of ['wheel', 'touchstart', 'pointerdown', 'keydown']) addEventListener(tipo, gesto, { capture: true, passive: true });
    addEventListener('scroll', () => estado !== 'feito' && scrollY > 40 && gesto(new Event('scroll')), { passive: true });
    document.addEventListener('visibilitychange', () => document.hidden && estado === 'contando' && parar());

    const pronto = () => {
      if (estado !== 'espera') return;
      adv.hidden = false;
      if (reduce || interagiu) parar();
      else contar();
    };
    if (reduce || fonte.classList.contains('gen-done')) pronto();
    else fonte.addEventListener('gen:done', pronto, { once: true });
  }
</script>
