---
// Trajetória e formação, ainda sobre a superfície aberta em "Como trabalho".
import BigTitle from './BigTitle.astro';
import { ptBR as s } from '../i18n/pt-BR';
---

<section class="section tl-sec" id="trajetoria">
  <BigTitle text={s.titulos.trajetoria} />
  <div class="cols">
    <ol class="tl">
      {
        s.trajetoria.map((t) => (
          <li data-fade>
            <p class="quando">{t.quando}</p>
            <h3>
              {t.onde} <span class="papel">· {t.papel}</span>
            </h3>
            <p class="txt">{t.texto}</p>
          </li>
        ))
      }
    </ol>
    <div class="form-col">
      <h3 class="sub">Formação</h3>
      <ul class="form">
        {
          s.formacao.map((f) => (
            <li>
              <span>
                <strong>{f.onde}</strong> · {f.texto}
              </span>
              <span class="quando">{f.quando}</span>
            </li>
          ))
        }
        <li><span>{s.idiomas}</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .tl-sec {
    background: var(--surface);
    padding-inline: var(--gutter);
    padding-top: 0;
  }
  .tl-sec :global(.big-title) {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .cols {
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    gap: 3rem;
  }
  .tl,
  .form {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }
  .quando {
    margin: 0 0 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  h3 {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  .papel {
    font-style: italic;
    color: var(--ink-2);
  }
  .txt {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .sub {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-bottom: 1rem;
  }
  .form li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--rule);
    font-size: 1.0625rem;
  }
  .form .quando {
    margin: 0;
  }
  .form strong {
    font-weight: 500;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
    }
  }
</style>
