---
// Introdução da página inicial: o nome aparece sozinho, a Terra surge girando e a câmera mergulha
// até São Paulo; no fim, a tela se abre para a abertura com a esfera de projetos.
// A Terra é 3D em WebGL (lib/terra3d.ts, com texturas da NASA). Se o WebGL ou as texturas não
// estiverem prontos a tempo, entra no lugar a Terra de pontos desenhada no canvas 2D.
// Toca ao abrir o portfólio. Sem JS ou com movimento reduzido, não existe: a página abre direto.
import { ptBR as s } from '../i18n/pt-BR';
import texDia from '../assets/terra-dia.jpg?url';
import texNoite from '../assets/terra-noite.jpg?url';
import texNoiteSp from '../assets/terra-noite-sp.jpg?url';
import { splitFallback } from '../lib/tokenize';
import { pontosDaTerra } from '../lib/terra';

const tokens = splitFallback(s.nome);
const pontos = JSON.stringify(pontosDaTerra());
---

<script is:inline>
  // Antes da primeira pintura: decide se a introdução toca. Ela toca sempre que o portfólio é
  // aberto, e não quando a pessoa volta de uma página do próprio site (de um projeto, por exemplo).
  // Se o script principal não começar até 1,5 s depois de a página carregar, ela abre sem a introdução.
  (function () {
    var d = document.documentElement;
    var interno = false;
    try {
      interno = !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch (e) {}
    // Dispositivo fraco, economia de dados ou conexão lenta: abre direto, sem a Terra em WebGL.
    var con = navigator.connection || {};
    var fraco =
      con.saveData ||
      /(^|-)2g$/.test(con.effectiveType || '') ||
      (navigator.deviceMemory && navigator.deviceMemory <= 2) ||
      (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2);
    if (interno || fraco || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    d.classList.add('intro-on');
    var desistir = function () {
      // O script da introdução já começou: ela mesma decide quando terminar.
      if (window.__introComecou || !d.classList.contains('intro-on')) return;
      d.classList.remove('intro-on');
      document.dispatchEvent(new Event('intro:fim'));
    };
    addEventListener('DOMContentLoaded', function () {
      setTimeout(desistir, 1500);
    });
    // Teto absoluto, para uma página que nunca termina de carregar.
    setTimeout(desistir, 15000);
  })();
</script>

<div class="intro-terra" aria-hidden="true" data-intro>
  <canvas class="c3d" data-dia={texDia} data-noite={texNoite} data-sp={texNoiteSp}></canvas>
  <canvas class="c2d"></canvas>
  <span class="i-pino"></span>
  <p class="i-nome">
    {
      tokens.map((t, i) => (
        <span class="mask">
          <span class="t" style={`--i:${i}`}>
            {t}
          </span>
        </span>
      ))
    }
    <span class="cur-wrap"><span class="cur"></span></span>
  </p>
  <p class="i-sub">{s.subtitulo}</p>
  <p class="i-local">São Bernardo do Campo, SP</p>
  <span class="i-brilho"></span>
  <button type="button" class="i-pular" tabindex="-1" data-pular>Pular</button>
  <script type="application/json" data-pontos set:html={pontos} />
</div>

<style>
  .intro-terra {
    display: none;
  }
  :global(html.intro-on) {
    overflow: hidden;
  }
  /* A abertura espera a introdução: as animações de entrada ficam paradas no primeiro quadro. */
  :global(html.intro-on .hero),
  :global(html.intro-on .hero *) {
    animation-play-state: paused !important;
  }
  /* Enquanto sai, a camada continua na tela (já sem a classe no html) para o esmaecimento rodar. */
  :global(html.intro-on) .intro-terra,
  .intro-terra.sai {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--paper);
    transition: opacity 0.7s var(--ease);
  }
  .intro-terra.sai {
    opacity: 0;
    pointer-events: none;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .c3d {
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .intro-terra.com-3d .c3d {
    opacity: 1;
  }
  /* São Bernardo do Campo fica no centro exato da tela durante o mergulho: um alfinete âmbar. */
  .i-pino {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .i-pino::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    animation: i-pulso 1.4s ease-out infinite;
  }
  .intro-terra.com-3d.desce .i-pino {
    opacity: 1;
  }
  .intro-terra.com-3d.chegou .i-pino {
    opacity: 0;
  }
  @keyframes i-pulso {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  .i-nome {
    position: relative;
    margin: 0;
    display: flex;
    align-items: flex-end;
    white-space: nowrap;
    font-size: clamp(3rem, min(11vw, 18svh), 9rem);
    font-variation-settings: 'opsz' 72;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--ink);
    transition:
      opacity 0.6s var(--ease),
      transform 0.9s var(--ease),
      filter 0.6s var(--ease);
  }
  .intro-terra.globo .i-nome {
    opacity: 0;
    transform: translateY(-0.35em) scale(0.92);
    filter: blur(6px);
  }
  .mask {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.16em 0.08em;
    margin-block: -0.16em -0.08em;
    white-space: pre;
  }
  .t {
    display: inline-block;
    animation: i-sobe 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(200ms + var(--i) * 170ms);
  }
  .cur-wrap {
    display: inline-block;
    margin-left: 0.06em;
    margin-bottom: 0.1em;
  }
  .cur {
    display: block;
    width: 0.32em;
    height: 0.62em;
    background: var(--accent);
    animation:
      i-aparece 300ms 700ms both,
      i-pisca 0.9s 1s steps(1) infinite;
  }

  .i-sub,
  .i-local {
    position: absolute;
    left: 50%;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
    translate: -50% 0;
  }
  .i-sub {
    top: calc(50% + clamp(3rem, min(11vw, 18svh), 9rem) * 0.75);
    color: var(--ink-2);
    animation: i-aparece 600ms 900ms both;
    transition: opacity 0.5s var(--ease);
  }
  /* Sai com outra animação: uma transição não venceria o preenchimento da animação de entrada. */
  .intro-terra.globo .i-sub {
    animation: i-some 400ms both;
  }
  /* O destino aparece embaixo enquanto a câmera desce até ele. */
  /* Numa pílula escura: no fim do vídeo, as luzes da cidade passam por trás do texto. */
  .i-local {
    bottom: max(2.5rem, 12svh);
    padding: 0.55rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
    background: rgb(14 14 16 / 0.72);
    backdrop-filter: blur(6px);
    color: var(--accent-text);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .intro-terra.desce .i-local {
    opacity: 1;
  }
  .intro-terra.chegou .i-local {
    opacity: 0;
  }

  /* Passagem para a abertura: o brilho da cidade cresce no centro da tela e encolhe até virar um
     ponto, o mesmo centro de onde os cartões da esfera saem. */
  .i-brilho {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60vmax;
    height: 60vmax;
    margin: -30vmax 0 0 -30vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(255 214 150 / 0.95) 0%,
      rgb(242 163 58 / 0.7) 12%,
      rgb(242 163 58 / 0.22) 34%,
      transparent 64%
    );
    opacity: 0;
    transform: scale(0.2);
    pointer-events: none;
  }
  .intro-terra.chegou .i-brilho {
    animation: i-brilho 1.25s cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  @keyframes i-brilho {
    0% {
      opacity: 0;
      transform: scale(0.35);
    }
    35% {
      opacity: 1;
      transform: scale(1.1);
    }
    100% {
      opacity: 0;
      transform: scale(0.015);
    }
  }
  .intro-terra.sai {
    transition-delay: 0.35s;
  }

  .i-pular {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    color: var(--ink-2);
    font: inherit;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    animation: i-aparece 500ms 600ms both;
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .i-pular:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }

  @keyframes i-sobe {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes i-aparece {
    from {
      opacity: 0;
    }
  }
  @keyframes i-some {
    to {
      opacity: 0;
    }
  }
  @keyframes i-pisca {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  // Linha do tempo (ms, a partir do momento em que o nome sai, em 1.300): a Terra surge girando
  // (1.300–2.600), vira até a América do Sul, mergulha até São Bernardo do Campo (2.700–4.600) e a
  // tela se abre (4.500). O nome fica na tela até a Terra 3D estar pronta, por no máximo 2,6 s;
  // sem ela, a Terra de pontos segue a mesma linha do tempo.
  import type { Terra3D } from '../lib/terra3d';

  const root = document.documentElement;
  const host = document.querySelector<HTMLElement>('[data-intro]');
  if (host && root.classList.contains('intro-on')) tocar(host);

  function tocar(host: HTMLElement) {
    // O script chegou a tempo: daqui em diante, a própria introdução decide quando terminar.
    (window as unknown as { __introComecou?: boolean }).__introComecou = true;
    const canvas = host.querySelector<HTMLCanvasElement>('.c2d')!;
    const tela3d = host.querySelector<HTMLCanvasElement>('.c3d')!;
    const ctx = canvas.getContext('2d')!;
    const bruto: number[] = JSON.parse(host.querySelector('[data-pontos]')!.textContent!);
    const RAD = Math.PI / 180;
    const n = bruto.length / 2;
    // Seno e cosseno de cada ponto, calculados uma vez só.
    const sLat = new Float32Array(n);
    const cLat = new Float32Array(n);
    const lon = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      const la = (bruto[2 * i] / 10) * RAD;
      sLat[i] = Math.sin(la);
      cLat[i] = Math.cos(la);
      lon[i] = (bruto[2 * i + 1] / 10) * RAD;
    }
    const DESTINO = { lat: -23.69, lon: -46.56 };
    const tinta = getComputedStyle(root).getPropertyValue('--ink').trim() || '#eceae4';
    const ambar = getComputedStyle(root).getPropertyValue('--accent').trim() || '#f2a33a';

    let w = 0;
    let h = 0;
    let dpr = 1;
    let terra: Terra3D | null = null;
    function medir() {
      dpr = Math.min(2, devicePixelRatio || 1);
      w = innerWidth;
      h = innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      terra?.medir();
    }
    medir();
    addEventListener('resize', medir, { passive: true });

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const faixa = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
    const suave = (x: number) => x * x * (3 - 2 * x);
    const entra = (x: number) => x * x * x * x;
    const vaivem = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const mistura = (a: number, b: number, x: number) => a + (b - a) * x;

    /** Terra de pontos (reserva): raio r, centro da vista em (lat0, lon0) e opacidade a. */
    function desenhar(r: number, lat0: number, lon0: number, a: number, marca: number) {
      ctx.clearRect(0, 0, w, h);
      if (a <= 0) return;
      const cx = w / 2;
      const cy = h / 2;
      ctx.globalAlpha = a;

      // Atmosfera e corpo do planeta.
      const halo = ctx.createRadialGradient(cx, cy, r * 0.96, cx, cy, r * 1.22);
      halo.addColorStop(0, 'rgba(242,163,58,0.16)');
      halo.addColorStop(1, 'rgba(242,163,58,0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(cx, cy, r * 1.22, 0, Math.PI * 2);
      ctx.fill();
      const corpo = ctx.createRadialGradient(cx - r * 0.35, cy - r * 0.4, r * 0.1, cx, cy, r);
      corpo.addColorStop(0, '#1d1d22');
      corpo.addColorStop(1, '#0b0b0d');
      ctx.fillStyle = corpo;
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(236,234,228,0.10)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Pontos em terra, projeção ortográfica; os da borda ficam menores e mais apagados.
      const sp = Math.sin(lat0 * RAD);
      const cp = Math.cos(lat0 * RAD);
      const l0 = lon0 * RAD;
      const tam = Math.max(1.1, r * 0.0105);
      ctx.fillStyle = tinta;
      for (let i = 0; i < n; i++) {
        const dl = lon[i] - l0;
        const cdl = Math.cos(dl);
        const z = sp * sLat[i] + cp * cLat[i] * cdl;
        if (z <= 0.02) continue;
        const x = cx + r * cLat[i] * Math.sin(dl);
        const y = cy - r * (cp * sLat[i] - sp * cLat[i] * cdl);
        if (x < -tam || x > w + tam || y < -tam || y > h + tam) continue;
        const s = tam * (0.45 + 0.55 * z);
        ctx.globalAlpha = a * (0.18 + 0.72 * z);
        // Pequenos, quadrados (rápido); de perto, redondos.
        if (s < 4) ctx.fillRect(x - s / 2, y - s / 2, s, s);
        else {
          ctx.beginPath();
          ctx.arc(x, y, s / 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // O destino: um ponto âmbar com um anel que pulsa.
      if (marca > 0) {
        const dl = DESTINO.lon * RAD - l0;
        const la = DESTINO.lat * RAD;
        const z = sp * Math.sin(la) + cp * Math.cos(la) * Math.cos(dl);
        if (z > 0) {
          const x = cx + r * Math.cos(la) * Math.sin(dl);
          const y = cy - r * (cp * Math.sin(la) - sp * Math.cos(la) * Math.cos(dl));
          // O alfinete não cresce com o zoom: a cidade continua sendo um ponto.
          const base = Math.min(7, Math.max(3, tam * 0.9));
          const pulso = (performance.now() % 1400) / 1400;
          ctx.globalAlpha = a * marca * (1 - pulso);
          ctx.strokeStyle = ambar;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(x, y, base * (1.5 + pulso * 3.5), 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = a * marca;
          ctx.fillStyle = ambar;
          ctx.beginPath();
          ctx.arc(x, y, base, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    // Terra 3D: o three.js e as texturas só baixam aqui, quando a introdução toca.
    let modo: 'espera' | '3d' | 'pontos' = 'espera';
    let pronta = false;
    import('../lib/terra3d')
      .then(({ criarTerra }) =>
        criarTerra(tela3d, { dia: tela3d.dataset.dia!, noite: tela3d.dataset.noite!, noiteSp: tela3d.dataset.sp! }),
      )
      .then((t) => {
        if (modo === 'pontos' || fim) return t.destruir();
        terra = t;
        pronta = true;
      })
      .catch(() => {
        // Sem WebGL ou sem texturas: a Terra de pontos assume quando o nome sair.
      });

    const t0 = performance.now();
    // Base da linha do tempo; muda se a Terra começar mais tarde que o previsto.
    let base = t0;
    function comecar(qual: '3d' | 'pontos', agora: number) {
      modo = qual;
      base = agora - 1300;
      if (qual === '3d') marcar('com-3d');
    }
    let fim = false;
    let quadro = 0;
    const etapas = new Set<string>();
    const marcar = (nome: string) => {
      if (etapas.has(nome)) return;
      etapas.add(nome);
      host.classList.add(nome);
    };

    function passo(agora: number) {
      const desde = agora - t0;
      if (modo === 'espera') {
        if (desde > 1300 && pronta) comecar('3d', agora);
        else if (desde > 2600) comecar('pontos', agora);
        else {
          quadro = requestAnimationFrame(passo);
          return;
        }
      }
      const t = agora - base;
      // Na Terra 3D o giro termina antes do alfinete aparecer, para ele já cair sobre a cidade.
      const giro = suave(faixa(t, 1300, modo === '3d' ? 3600 : 4300));
      const lat0 = mistura(6, DESTINO.lat, giro);

      if (modo === '3d' && terra) {
        // Distância da câmera ao centro (raio = 1): a Terra chega grande (~70% da altura) e a
        // altitude cai em escala logarítmica, como num mergulho de verdade, até a região de SP
        // ocupar a tela.
        const surge = 1 - Math.pow(1 - faixa(t, 1300, 2600), 3);
        const mergulho = vaivem(faixa(t, 2700, 4600));
        const alt = mistura(6.5, 3.8, surge) * Math.pow(0.19 / 3.8, mergulho);
        terra.quadro(lat0, mistura(18, DESTINO.lon, giro), 1 + alt);
        if (t > 1300) marcar('globo');
        if (t > 3700) marcar('desce');
        if (t > 4250) marcar('chegou');
        if (t > 4500) terminar();
        if (t < 5300) quadro = requestAnimationFrame(passo);
        return;
      }

      const m = Math.min(w, h);
      const surge = suave(faixa(t, 1700, 2900));
      const mergulho = entra(faixa(t, 2900, 4800));
      // Raio: aparece em 30% da tela e cresce até a cidade ocupar a tela inteira.
      const r = mistura(m * 0.18, m * 0.34, surge) + mergulho * Math.max(w, h) * 5;
      const lon0 = mistura(DESTINO.lon + 150, DESTINO.lon, giro);
      const a = surge * (1 - faixa(t, 4550, 4900));
      desenhar(r, lat0, lon0, a, faixa(t, 2700, 3200));

      if (t > 1300) marcar('globo');
      if (t > 3100) marcar('desce');
      if (t > 4400) marcar('chegou');
      // A tela começa a se abrir com o mergulho ainda em curso; o desenho segue até sumir.
      if (t > 4600) terminar();
      if (t < 5400) quadro = requestAnimationFrame(passo);
    }

    function terminar() {
      if (fim) return;
      fim = true;
      host.classList.add('sai');
      root.classList.remove('intro-on');
      document.dispatchEvent(new Event('intro:fim'));
      setTimeout(() => {
        cancelAnimationFrame(quadro);
        terra?.destruir();
        host.remove();
      }, 1100);
    }

    host.querySelector('[data-pular]')!.addEventListener('click', terminar);
    addEventListener('keydown', (e) => e.key === 'Escape' && terminar());
    quadro = requestAnimationFrame(passo);
  }
</script>
