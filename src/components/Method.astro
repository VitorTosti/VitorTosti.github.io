---
// Como trabalho: as quatro etapas em sequência, numeradas porque a ordem importa.
// Abre o painel claro-escuro (superfície) que continua pela trajetória.
import BigTitle from './BigTitle.astro';
import { ptBR as s } from '../i18n/pt-BR';
---

<section class="section painel" id="metodo">
  <BigTitle text={s.titulos.metodo} />
  <ol class="etapas">
    {
      s.metodo.map((passo, i) => (
        <li data-fade style={`--d:${i * 90}ms`}>
          <span class="n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3>{s.metodoNomes[i]}</h3>
            <p>{passo}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .painel {
    background: var(--surface);
    border-radius: clamp(2rem, 4vw, 3.75rem) clamp(2rem, 4vw, 3.75rem) 0 0;
    padding-inline: var(--gutter);
    margin-top: clamp(3rem, 8vw, 6rem);
  }
  .painel :global(.big-title) {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .etapas {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 64rem;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }
  li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .n {
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    min-width: 1.3em;
    font-variation-settings: 'opsz' 72;
  }
  h3 {
    margin: 0 0 0.375rem;
    font-family: var(--mono);
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }
  p {
    margin: 0;
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
