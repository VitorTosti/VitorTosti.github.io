---
// Texto que se escreve token a token. O texto completo está no HTML desde o início; a animação só revela.
// Tokens com alternativas são focáveis (tabindex móvel) e descrevem o top-5 via aria-describedby.
import { alternativas } from '../data/alternativas';
import { formatPct, generationTimes, resolveFrase, splitNumber, toRender } from '../lib/tokenize';
import { ptBR as s } from '../i18n/pt-BR';

interface Props {
  /** id da frase em alternativas.json; omitido para texto sem alternativas (ex.: números). */
  id?: string;
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span' | 'strong';
  class?: string;
  /** 'load' começa ao carregar; 'view' quando entra na tela. */
  trigger?: 'load' | 'view';
  /** 'numero' divide dígito a dígito. */
  mode?: 'texto' | 'numero';
  /** Mantém o cursor piscando no fim. */
  keepCursor?: boolean;
  /** Antes de cada token fixar, os candidatos do top-5 piscam no lugar dele. */
  flicker?: boolean;
  /** Tokens alimentam o painel lateral da abertura em vez do painel flutuante. */
  lens?: boolean;
  /** Seletor de outro texto gerado: este só começa quando aquele termina. */
  startAfter?: string;
  /** id do elemento gerado, para outro texto encadear nele. */
  elId?: string;
  /** 'rapido' para parágrafos: ritmo de leitura, não de título. */
  ritmo?: 'titulo' | 'rapido';
  seed?: number;
}

const {
  id,
  text,
  as: Tag = 'span',
  class: cls,
  trigger = 'view',
  mode = 'texto',
  keepCursor = false,
  flicker = false,
  lens = false,
  startAfter,
  ritmo = 'titulo',
  seed = 7,
} = Astro.props;

const tokens =
  mode === 'numero' ? splitNumber(text).map((t) => toRender(t)) : resolveFrase(id ?? '', text, id ? alternativas : null);
// Com flicker cada posição precisa de tempo para os candidatos aparecerem antes do token fixar.
const [base, jitter, pausa] =
  mode === 'numero' ? [70, 40, 160] : flicker ? [150, 70, 160] : ritmo === 'rapido' ? [14, 14, 90] : [42, 58, 160];
const times = generationTimes(
  tokens.map((k) => k.lead + k.text),
  seed,
  base,
  jitter,
  pausa,
);
const uid = `g-${id ?? 'n'}-${Math.abs(text.split('').reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0)).toString(36)}`;
const comAlts = tokens.map((k) => k.alts.length > 0 || k.foraDoTop);
const primeiro = comAlts.indexOf(true);

const descricao = (i: number) => {
  const k = tokens[i];
  const lista = k.alts.map((a) => `${a.t.trim() || a.t} ${formatPct(a.p)}`).join(', ');
  const extra = k.foraDoTop ? `; "${k.text}" ${s.painel.foraDoTop}` : '';
  return s.painel.descricao(k.text, lista + extra);
};
---

<Tag
  id={Astro.props.elId}
  class:list={['gen', cls]}
  data-gen
  data-trigger={trigger}
  data-times={times.join(',')}
  data-keep-cursor={keepCursor ? '' : undefined}
  data-flicker={flicker ? '' : undefined}
  data-start-after={startAfter}
>
  {
    tokens.map((k, i) =>
      comAlts[i] ? (
        <Fragment>
          {k.lead}
          <span
            class="tok"
            data-i={i}
            data-lens={lens ? '' : undefined}
            tabindex={i === primeiro ? '0' : '-1'}
            aria-describedby={`${uid}-${i}`}
            data-alts={JSON.stringify({ t: k.text, p: k.p, a: k.alts, f: k.foraDoTop })}
          >
            {k.text}
          </span>
        </Fragment>
      ) : (
        <Fragment>
          {k.lead}
          <span class="tok" data-i={i}>
            {k.text}
          </span>
        </Fragment>
      ),
    )
  }
</Tag>
{
  primeiro >= 0 && (
    <span hidden>
      {tokens.map((_, i) => comAlts[i] && <span id={`${uid}-${i}`}>{descricao(i)}</span>)}
    </span>
  )
}

<style is:global>
  .gen {
    position: relative;
  }
  .gen .tok[data-alts] {
    cursor: help;
    border-radius: 2px;
    text-decoration: underline dotted var(--bar);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.14em;
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .gen .tok[data-alts]:hover,
  .gen .tok[data-alts][data-active] {
    background: var(--accent-wash);
    color: var(--accent-text);
    text-decoration-color: var(--accent);
  }
  .gen .tok[data-alts]:focus-visible {
    outline-offset: 1px;
  }

  /* Antes de gerar: tokens escondidos (só com JS e sem movimento reduzido; ver Base.astro). */
  .gen-on .gen:not(.gen-done) .tok:not(.on),
  .gen.gen-replay:not(.gen-done) .tok:not(.on) {
    opacity: 0;
  }
  /* Candidato que pisca no lugar do token antes dele fixar; fora do fluxo, sem mexer no layout. */
  .gen-flick {
    position: absolute;
    left: 0;
    top: 0;
    white-space: pre;
    color: var(--ink-2);
    font-style: italic;
    pointer-events: none;
  }
  .gen .tok.on {
    animation: tok-in var(--t-slow) var(--ease) both;
  }
  @keyframes tok-in {
    0% {
      opacity: 0;
      color: var(--accent-text);
    }
    30% {
      opacity: 1;
      color: var(--accent-text);
    }
    100% {
      opacity: 1;
    }
  }

  .gen-cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0.5em;
    background: var(--accent);
    pointer-events: none;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .gen-cursor.typing {
    animation: none;
  }
  .gen-cursor.out {
    opacity: 0;
    animation: none;
    transition: opacity var(--t-base) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .gen-cursor {
      animation: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function placeCursor(host: HTMLElement, cursor: HTMLElement, tok: Element | null) {
    const hostBox = host.getBoundingClientRect();
    let x = 0;
    let y = 0;
    let h = parseFloat(getComputedStyle(host).fontSize);
    if (tok) {
      const rects = tok.getClientRects();
      const last = rects[rects.length - 1];
      if (last) {
        x = last.right - hostBox.left + h * 0.08;
        y = last.top - hostBox.top + last.height * 0.12;
        h = last.height * 0.78;
      }
    }
    cursor.style.height = `${h}px`;
    cursor.style.transform = `translate(${x}px, ${y}px)`;
  }

  type Dados = { t: string; a: { t: string; p: number }[] };

  /** Mostra 2 candidatos do top-5 (diferentes do escolhido) na posição do token, 60 ms cada. */
  function flick(host: HTMLElement, tok: HTMLElement): number {
    if (!host.hasAttribute('data-flicker') || !tok.dataset.alts) return 0;
    const d: Dados = JSON.parse(tok.dataset.alts);
    const outros = d.a.map((a) => a.t.trim()).filter((t) => t && t !== d.t.trim()).slice(0, 2);
    if (!outros.length) return 0;
    const hostBox = host.getBoundingClientRect();
    const r = tok.getClientRects()[0];
    if (!r) return 0;
    const el = document.createElement('span');
    el.className = 'gen-flick';
    el.setAttribute('aria-hidden', 'true');
    el.style.transform = `translate(${r.left - hostBox.left}px, ${r.top - hostBox.top}px)`;
    host.append(el);
    outros.forEach((t, j) => setTimeout(() => (el.textContent = t), j * 60));
    setTimeout(() => el.remove(), outros.length * 60);
    return outros.length * 60;
  }

  function generate(host: HTMLElement) {
    const toks = [...host.querySelectorAll<HTMLElement>('.tok')];
    const times = (host.dataset.times ?? '').split(',').map(Number);
    host.querySelector('.gen-cursor')?.remove();
    const cursor = document.createElement('span');
    cursor.className = 'gen-cursor typing';
    cursor.setAttribute('aria-hidden', 'true');
    host.append(cursor);
    placeCursor(host, cursor, null);

    toks.forEach((tok, i) => {
      setTimeout(() => {
        const espera = flick(host, tok);
        setTimeout(() => {
          tok.classList.add('on');
          placeCursor(host, cursor, tok);
          host.dispatchEvent(new CustomEvent('gen:token', { detail: { i, tok } }));
          if (i === toks.length - 1) finish(host, cursor, tok);
        }, espera);
      }, times[i] ?? i * 60);
    });
  }

  function finish(host: HTMLElement, cursor: HTMLElement, last: Element) {
    host.classList.add('gen-done');
    host.classList.remove('gen-replay');
    cursor.classList.remove('typing');
    host.dispatchEvent(new CustomEvent('gen:done'));
    if (host.hasAttribute('data-keep-cursor')) {
      addEventListener('resize', () => placeCursor(host, cursor, last), { passive: true });
    } else {
      setTimeout(() => cursor.classList.add('out'), 1600);
      setTimeout(() => cursor.remove(), 2000);
    }
  }

  // Gerar de novo a pedido de quem visita: funciona também com movimento reduzido, porque é a pessoa que pede.
  document.addEventListener('gen:replay', (e) => {
    const host = e.target as HTMLElement;
    if (!host.matches?.('[data-gen]')) return;
    host.querySelectorAll('.tok.on').forEach((t) => t.classList.remove('on'));
    host.classList.remove('gen-done');
    host.classList.add('gen-replay');
    generate(host);
  });

  const hosts = [...document.querySelectorAll<HTMLElement>('[data-gen]')];
  if (reduce) {
    hosts.forEach((h) => {
      h.classList.add('gen-done');
      // Cursor parado no fim, sem piscar: o sinal de "texto gerado" continua sem movimento.
      if (h.hasAttribute('data-keep-cursor')) {
        const cursor = document.createElement('span');
        cursor.className = 'gen-cursor';
        cursor.setAttribute('aria-hidden', 'true');
        h.append(cursor);
        const last = [...h.querySelectorAll('.tok')].at(-1) ?? null;
        const pos = () => placeCursor(h, cursor, last);
        document.fonts?.ready.then(pos, pos);
        addEventListener('resize', pos, { passive: true });
      }
    });
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          generate(e.target as HTMLElement);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    const start = () =>
      hosts.forEach((h) => {
        const depois = h.dataset.startAfter && document.querySelector(h.dataset.startAfter);
        if (depois) depois.addEventListener('gen:done', () => setTimeout(() => generate(h), 180), { once: true });
        else if (h.dataset.trigger === 'load') setTimeout(() => generate(h), 250);
        else io.observe(h);
      });
    // Espera as fontes para o cursor não medir a fonte de reserva.
    document.fonts?.ready.then(start, start) ?? start();
  }
</script>
