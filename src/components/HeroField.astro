---
// Fundo da abertura: a pauta da folha de log se enche de linhas sendo decodificadas token a token.
// O texto é o próprio conteúdo do site (chamadas reais dos rastros, saídas, correções e o top-5 de
// cada posição dos títulos) e só ocupa o espaço vazio: cada linha contorna o texto da abertura.
// Enquanto o título é gerado, a linha dele recebe o top-5 daquela posição, à direita da palavra.
// Sem movimento (reduzido ou sem JS de geração), fica uma folha estática, já escrita.
import { infocaijMcp, outrosProjetos } from '../data/projetos';
import { alternativas } from '../data/alternativas';
import { correcaoTexto } from '../lib/field';
import { formatPct } from '../lib/tokenize';
import type { Passo } from '../lib/trace';

const fmtArgs = (a: Record<string, unknown>) =>
  Object.entries(a)
    .map(([k, v]) => `${k}: ${JSON.stringify(v)}`)
    .join(', ');

const doPasso = (p: Passo): string[] => {
  if (p.tipo === 'pergunta') return [`› ${p.texto}`];
  if (p.tipo === 'chamada') return [`${p.ferramenta}(${fmtArgs(p.args)})`];
  if (p.tipo === 'saida') return [`← ${p.texto}`, ...(p.aviso ? [`! ${p.aviso}`] : [])];
  return p.itens.map((i) => `✓ ${i}`);
};

const linhas: string[] = [];
for (const proj of [infocaijMcp, ...outrosProjetos]) {
  for (const p of proj.rastro ?? []) linhas.push(...doPasso(p));
  for (const c of 'correcoes' in proj ? (proj.correcoes ?? []) : []) linhas.push(...correcaoTexto(c));
}
for (const frase of Object.values(alternativas.frases)) {
  for (const k of frase.tokens) {
    // Posições de pontuação (".", ",") ficam de fora: no fundo viram ruído.
    if (k.alts.length < 2 || k.t.trim().length < 2) continue;
    linhas.push(k.alts.map((a) => `${a.t.trim() || a.t} ${formatPct(a.p)}`).join(' · '));
  }
}
---

<div class="field" aria-hidden="true" data-field={JSON.stringify(linhas)}>
  <canvas></canvas>
</div>

<style>
  .field {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .field.on canvas {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    canvas {
      transition: none;
    }
  }
</style>

<script>
  import { montarCampo } from '../lib/field-client';

  const el = document.querySelector<HTMLElement>('[data-field]');
  if (el) {
    const iniciar = () => montarCampo(el);
    // As fontes precisam estar prontas para medir os tokens; não bloqueia a abertura.
    if (document.fonts?.ready) document.fonts.ready.then(iniciar);
    else addEventListener('load', iniciar);
  }
</script>
