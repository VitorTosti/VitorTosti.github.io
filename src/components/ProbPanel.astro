---
// Painel único com as alternativas do token em foco. Visual apenas (aria-hidden): o mesmo conteúdo
// chega aos leitores de tela pelo aria-describedby de cada token. No celular vira folha inferior.
import { alternativas } from '../data/alternativas';
import { ptBR as s } from '../i18n/pt-BR';

const fonte =
  alternativas.fonte.tipo === 'gemini' ? `top-5 · ${alternativas.fonte.modelo}` : 'top-5 · ilustrativo';
---

<div id="prob" class="prob" aria-hidden="true" data-escolhido={s.painel.escolhido} data-fora={s.painel.foraDoTop}>
  <div class="prob-head">
    <span>{fonte}</span>
    <button type="button" class="prob-close" tabindex="-1">{s.painel.fechar}</button>
  </div>
  <ol class="prob-list"></ol>
</div>

<style>
  .prob {
    position: absolute;
    z-index: 20;
    width: 17.5rem;
    padding: 0.75rem 0.875rem 0.875rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease),
      visibility 0s linear var(--t-fast);
  }
  .prob.open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease);
  }
  .prob-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--ink-2);
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .prob-close {
    display: none;
    font: inherit;
    color: var(--ink-2);
    background: none;
    border: 0;
    padding: 0.5rem;
    margin: -0.5rem;
    cursor: pointer;
  }
  .prob-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }
  .prob-list :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) 1fr 2.75rem;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink-2);
  }
  .prob-list :global(.t) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: pre;
  }
  .prob-list :global(.bar) {
    height: 3px;
    background: var(--rule);
    position: relative;
  }
  .prob-list :global(.bar > i) {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--bar);
    transform-origin: left;
    animation: bar-in var(--t-base) var(--ease) both;
  }
  .prob-list :global(.pct) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .prob-list :global(li.chosen) {
    color: var(--ink);
  }
  .prob-list :global(li.chosen .t) {
    color: var(--accent-text);
  }
  .prob-list :global(li.chosen .bar > i) {
    background: var(--accent);
  }
  .prob-list :global(li.off) {
    border-top: 1px dashed var(--rule);
    padding-top: 0.375rem;
    color: var(--ink);
  }
  @keyframes bar-in {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 639px), (pointer: coarse) {
    .prob {
      position: fixed;
      inset: auto 0 0 0;
      width: auto;
      padding: 1rem var(--gutter) calc(1.25rem + env(safe-area-inset-bottom));
      border-radius: 12px 12px 0 0;
      border-width: 1px 0 0;
      font-size: 0.875rem;
      transform: translateY(100%);
      transition:
        transform var(--t-base) var(--ease),
        visibility 0s linear var(--t-base);
      opacity: 1;
      top: auto !important;
      left: 0 !important;
    }
    .prob.open {
      transform: none;
      transition: transform var(--t-base) var(--ease);
    }
    .prob-close {
      display: block;
    }
    .prob-list :global(li) {
      grid-template-columns: minmax(0, 8.5rem) 1fr 3rem;
      gap: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prob,
    .prob.open {
      transition: none;
    }
    .prob-list :global(.bar > i) {
      animation: none;
    }
  }
</style>

<script>
  import { formatPct } from '../lib/tokenize';

  type Dados = { t: string; p: number | null; a: { t: string; p: number }[]; f: boolean };

  const panel = document.getElementById('prob')!;
  const list = panel.querySelector('.prob-list')!;
  const sheet = matchMedia('(max-width: 639px), (pointer: coarse)');
  let atual: HTMLElement | null = null;
  let hideTimer = 0;

  function row(t: string, p: number | null, cls: string, rotulo?: string) {
    const li = document.createElement('li');
    if (cls) li.className = cls;
    const nome = document.createElement('span');
    nome.className = 't';
    nome.textContent = t.trim() || JSON.stringify(t);
    const bar = document.createElement('span');
    bar.className = 'bar';
    const fill = document.createElement('i');
    fill.style.width = p == null ? '0' : `${Math.max(p * 100, 1.5)}%`;
    bar.append(fill);
    const pct = document.createElement('span');
    pct.className = 'pct';
    pct.textContent = rotulo ?? (p == null ? '–' : formatPct(p));
    li.append(nome, bar, pct);
    return li;
  }

  function show(tok: HTMLElement) {
    clearTimeout(hideTimer);
    const d: Dados = JSON.parse(tok.dataset.alts!);
    list.replaceChildren(
      ...d.a.map((a) => row(a.t, a.p, a.t.trim() === d.t.trim() ? 'chosen' : '')),
      ...(d.f ? [row(d.t, null, 'off chosen', panel.dataset.fora)] : []),
    );
    atual?.removeAttribute('data-active');
    atual = tok;
    tok.dataset.active = '';

    if (!sheet.matches) {
      const r = tok.getBoundingClientRect();
      const w = panel.offsetWidth || 280;
      const left = Math.min(Math.max(r.left + scrollX, 8), scrollX + document.documentElement.clientWidth - w - 8);
      panel.style.left = `${left}px`;
      panel.style.top = `${r.bottom + scrollY + 8}px`;
    }
    panel.classList.add('open');
  }

  function hide(delay = 0) {
    clearTimeout(hideTimer);
    const fechar = () => {
      panel.classList.remove('open');
      atual?.removeAttribute('data-active');
      atual = null;
    };
    if (delay) hideTimer = window.setTimeout(fechar, delay);
    else fechar();
  }

  // Tokens da abertura (data-lens) alimentam o painel lateral dela; este painel cuida dos outros títulos.
  const tokOf = (el: EventTarget | null) =>
    (el as Element | null)?.closest?.<HTMLElement>('.tok[data-alts]:not([data-lens])') ?? null;
  const tokNav = (el: EventTarget | null) => (el as Element | null)?.closest?.<HTMLElement>('.tok[data-alts]') ?? null;

  document.addEventListener('pointerover', (e) => {
    if (e.pointerType !== 'mouse') return;
    const tok = tokOf(e.target);
    if (tok) show(tok);
  });
  document.addEventListener('pointerout', (e) => {
    if (e.pointerType !== 'mouse') return;
    if (tokOf(e.target) && !tokOf(e.relatedTarget)) hide(120);
  });
  document.addEventListener('focusin', (e) => {
    const tok = tokOf(e.target);
    if (tok) show(tok);
  });
  document.addEventListener('focusout', (e) => {
    if (tokOf(e.target) && !tokOf(e.relatedTarget)) hide(80);
  });
  // O foco (que já abre o painel) chega antes do clique; o toque só fecha se o painel já estava aberto nele.
  let abertoAntes = false;
  document.addEventListener('pointerdown', (e) => {
    abertoAntes = !!atual && atual === tokOf(e.target) && panel.classList.contains('open');
  });
  document.addEventListener('click', (e) => {
    const tok = tokOf(e.target);
    if (tok) {
      if (abertoAntes && sheet.matches) hide();
      else show(tok);
      return;
    }
    if (!panel.contains(e.target as Node) || (e.target as Element).closest('.prob-close')) hide();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('open')) {
      hide();
      return;
    }
    const tok = tokNav(e.target);
    if (!tok || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End')) return;
    // Tabindex móvel: uma parada de Tab por título, setas andam entre os tokens.
    const host = tok.closest('[data-gen]')!;
    const toks = [...host.querySelectorAll<HTMLElement>('.tok[data-alts]')];
    let i = toks.indexOf(tok);
    if (e.key === 'ArrowRight') i = Math.min(i + 1, toks.length - 1);
    if (e.key === 'ArrowLeft') i = Math.max(i - 1, 0);
    if (e.key === 'Home') i = 0;
    if (e.key === 'End') i = toks.length - 1;
    e.preventDefault();
    toks.forEach((t, j) => t.setAttribute('tabindex', j === i ? '0' : '-1'));
    toks[i].focus();
  });

  addEventListener('resize', () => atual && !sheet.matches && show(atual), { passive: true });
</script>
