---
// Projeto contado como rastro, em formato mais curto que o destaque. Mídia extra entra pelo slot.
import AgentTrace from './AgentTrace.astro';
import type { ProjetoCurto } from '../data/projetos';

interface Props {
  p: ProjetoCurto;
  n: number;
}
const { p, n } = Astro.props;
---

<article class="proj" id={p.slug} aria-labelledby={`h-${p.slug}`}>
  <header class="head">
    <p class="label">
      {String(n).padStart(2, '0')}
      {p.status && <span class:list={['st', { andamento: p.status === 'em andamento' }]}>{p.status}</span>}
    </p>
    <h3 id={`h-${p.slug}`}>{p.nome}</h3>
    <p class="resumo">{p.resumo}</p>
  </header>

  <AgentTrace passos={p.rastro} titulo={p.slug} />

  <slot />

  <footer class="meta mono">
    {p.stack && <p class="stack">{p.stack}</p>}
    <p>
      {p.nota && <span class="nota">{p.nota} </span>}
      {p.link.href ? <a href={p.link.href}>{p.link.rotulo} ↗</a> : <span class="todo">{p.link.rotulo}</span>}
    </p>
  </footer>
</article>

<style>
  .proj {
    padding-top: 4rem;
    margin-top: 4rem;
    border-top: 1px solid var(--rule);
  }
  .head {
    max-width: var(--col);
    margin-bottom: 1.75rem;
  }
  .label {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .st {
    padding: 0 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .st.andamento {
    border-style: dashed;
    color: var(--ink);
  }
  h3 {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    margin: 0.5rem 0 1rem;
  }
  .resumo {
    margin: 0;
  }
  .proj > :global(.trace),
  .proj > :global(*:not(.head):not(.meta)) {
    margin-top: 1.75rem;
  }
  .meta {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .meta p {
    margin: 0 0 0.375rem;
  }
  .meta a {
    color: var(--ink);
  }
  .todo {
    border-bottom: 1px dashed var(--bar);
  }
</style>
