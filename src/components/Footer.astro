---
import { alternativas } from '../data/alternativas';
import { ptBR as s } from '../i18n/pt-BR';

const { fonte } = alternativas;
const nota = fonte.tipo === 'gemini' ? s.rodape.reais(fonte.modelo!, fonte.geradoEm ?? '') : s.rodape.ilustrativas;
---

<footer class="foot wide">
  <div class="inner">
  <p class="label" id="nota-probabilidades">{nota}</p>
  <p class="label">© {new Date().getFullYear()} {s.nome} · feito com Astro, sem rastreamento</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: 2rem;
  }
  .inner {
    padding-block: 2.5rem 4rem;
    border-top: 1px solid var(--rule);
  }
  .foot p {
    max-width: 44rem;
    line-height: 1.6;
  }
</style>
