---
// Abertura de seção como num rastro: a pergunta de quem visita, e o título gerado como resposta.
import GeneratedText from './GeneratedText.astro';
import { ptBR as s } from '../i18n/pt-BR';

type Id = keyof typeof s.perguntas;
interface Props {
  id: Id;
  class?: string;
}
const { id, class: cls } = Astro.props;
---

<div class:list={['shead', cls]}>
  <p class="ask"><span class="pr" aria-hidden="true">›</span> {s.perguntas[id]}</p>
  <GeneratedText id={id} text={s.frases[id]} as="h2" class="section-title" />
</div>

<style>
  .shead {
    margin-bottom: 2rem;
  }
  .shead :global(.section-title) {
    margin-bottom: 0;
    max-width: 22ch;
  }
  .ask {
    margin: 0 0 0.875rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .pr {
    color: var(--accent-text);
    margin-right: 0.25rem;
  }
</style>
