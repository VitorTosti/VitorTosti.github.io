---
// Painel "logit lens" da abertura: o top-5 de cada posição enquanto a frase é gerada, com temperatura.
// O HTML já vem com a posição mais disputada renderizada; o script só atualiza.
import { alternativas } from '../data/alternativas';
import { aplicarTemperatura, maisDisputado, maisProvavel } from '../lib/lens';
import { formatPct, resolveFrase } from '../lib/tokenize';
import { ptBR as s } from '../i18n/pt-BR';

const tokens = resolveFrase('abertura', s.frases.abertura, alternativas);
const i0 = maisDisputado(tokens);
const k0 = tokens[i0];
const fonte = alternativas.fonte.tipo === 'gemini' ? alternativas.fonte.modelo : 'ilustrativo';
const topo0 = k0 ? maisProvavel(k0.alts) : null;
const nota0 =
  k0 && topo0 && topo0.t.trim() !== k0.text ? s.lente.quase(topo0.t.trim(), k0.text) : k0 ? s.lente.provavel(k0.text) : '';
---

{
  k0 && (
    <aside class="lens" aria-labelledby="lens-titulo" data-fonte={fonte}>
      <div class="head">
        <h2 id="lens-titulo" class="ttl">
          {s.lente.titulo} <span class="pos">· posição <span data-pos>{i0 + 1}</span></span>
        </h2>
        <span class="src">{fonte}</span>
      </div>
      <p class="tok-atual" data-tok>
        {k0.text}
      </p>
      <ol class="rows" data-rows aria-label={s.lente.lista}>
        {aplicarTemperatura(k0.alts, 1).map((a) => (
          <li class:list={{ ch: a.t.trim() === k0.text }}>
            <span class="t">{a.t.trim() || a.t}</span>
            <span class="bar" aria-hidden="true">
              <i style={`transform:scaleX(${Math.max(a.p, 0.015).toFixed(3)})`} />
            </span>
            <span class="pct">{formatPct(a.p)}</span>
          </li>
        ))}
      </ol>
      <p class="nota" data-nota aria-live="polite">
        {nota0}
      </p>
      <div class="ctl">
        <label for="lens-temp">{s.lente.temperatura}</label>
        <input id="lens-temp" type="range" min="0.2" max="2" step="0.1" value="1" data-temp />
        <output for="lens-temp" data-temp-out>1,0</output>
      </div>
      <p class="ajuda">{s.lente.ajuda}</p>
      <button type="button" class="again" data-again>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v2.8h-2.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {s.lente.denovo}
      </button>
    </aside>
  )
}

<style>
  .lens {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .ttl {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    line-height: 1.4;
  }
  .src {
    font-size: 0.6875rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0 0.375rem;
  }
  .tok-atual {
    margin: 0.75rem 0 0.75rem;
    font-family: var(--serif);
    font-size: 2.25rem;
    line-height: 1.1;
    color: var(--accent-text);
    min-height: 1.1em;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .rows :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 7rem) 1fr 3rem;
    gap: 0.75rem;
    align-items: center;
  }
  .rows :global(.t) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rows :global(.bar) {
    height: 4px;
    background: var(--rule);
    position: relative;
    overflow: hidden;
  }
  .rows :global(.bar i) {
    position: absolute;
    inset: 0;
    background: var(--bar);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease);
  }
  .rows :global(.pct) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .rows :global(li.ch) {
    color: var(--ink);
  }
  .rows :global(li.ch .t) {
    color: var(--accent-text);
  }
  .rows :global(li.ch .bar i) {
    background: var(--accent);
  }
  .nota {
    margin: 1rem 0 0;
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--ink);
    min-height: 2.7em;
  }
  .ctl {
    display: grid;
    grid-template-columns: auto 1fr 2.5rem;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1rem;
  }
  .ctl output {
    text-align: right;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    min-height: 44px;
    background: transparent;
  }
  .ajuda {
    margin: 0.125rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.5;
  }
  .again {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.875rem;
    min-height: 44px;
    padding: 0 0.875rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
    transition:
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .again:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .again:active svg {
    transform: rotate(-90deg);
  }
  .again svg {
    transition: transform var(--t-base) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .rows :global(.bar i),
    .again svg {
      transition: none;
    }
  }
</style>

<script>
  import { aplicarTemperatura, maisDisputado, maisProvavel } from '../lib/lens';
  import { formatPct } from '../lib/tokenize';
  import { ptBR as s } from '../i18n/pt-BR';

  type Dados = { t: string; p: number | null; a: { t: string; p: number }[] };

  const lens = document.querySelector<HTMLElement>('.lens');
  const host = document.querySelector<HTMLElement>('.hero [data-gen]');
  if (lens && host) {
    const rows = lens.querySelector<HTMLOListElement>('[data-rows]')!;
    const tokEl = lens.querySelector<HTMLElement>('[data-tok]')!;
    const posEl = lens.querySelector<HTMLElement>('[data-pos]')!;
    const nota = lens.querySelector<HTMLElement>('[data-nota]')!;
    const temp = lens.querySelector<HTMLInputElement>('[data-temp]')!;
    const tempOut = lens.querySelector<HTMLOutputElement>('[data-temp-out]')!;
    const meta = document.querySelector<HTMLElement>('[data-hero-meta]');
    const toks = [...host.querySelectorAll<HTMLElement>('.tok')];
    const comAlts = toks.filter((t) => t.dataset.alts);
    const dados = (t: HTMLElement): Dados => JSON.parse(t.dataset.alts!);
    let atual: HTMLElement | null = null;
    let gerando = false;

    const disputado = () => {
      const i = maisDisputado(comAlts.map((t) => ({ alts: dados(t).a })));
      return i >= 0 ? comAlts[i] : null;
    };

    function linha(t: string, p: number, escolhido: boolean) {
      const li = document.createElement('li');
      if (escolhido) li.className = 'ch';
      const n = document.createElement('span');
      n.className = 't';
      n.textContent = t.trim() || t;
      const bar = document.createElement('span');
      bar.className = 'bar';
      bar.setAttribute('aria-hidden', 'true');
      const fill = document.createElement('i');
      fill.style.transform = `scaleX(${Math.max(p, 0.015).toFixed(3)})`;
      bar.append(fill);
      const pct = document.createElement('span');
      pct.className = 'pct';
      pct.textContent = formatPct(p);
      li.append(n, bar, pct);
      return li;
    }

    function mostrar(tok: HTMLElement, falar = true) {
      const d = dados(tok);
      const T = Number(temp.value);
      const lista = aplicarTemperatura(d.a, T);
      // Atualiza as barras no lugar quando a lista é a mesma, para a escala animar em vez de piscar.
      const mesmo = atual === tok && rows.children.length === lista.length;
      if (mesmo) {
        lista.forEach((a, j) => {
          const li = rows.children[j] as HTMLElement;
          (li.querySelector('.bar i') as HTMLElement).style.transform = `scaleX(${Math.max(a.p, 0.015).toFixed(3)})`;
          li.querySelector('.pct')!.textContent = formatPct(a.p);
        });
      } else {
        rows.replaceChildren(...lista.map((a) => linha(a.t, a.p, a.t.trim() === d.t.trim())));
      }
      atual?.removeAttribute('data-active');
      atual = tok;
      tok.dataset.active = '';
      tokEl.textContent = d.t;
      posEl.textContent = String(Number(tok.dataset.i) + 1);
      if (falar) {
        const topo = maisProvavel(lista);
        nota.textContent =
          topo && topo.t.trim() !== d.t.trim() ? s.lente.quase(topo.t.trim(), d.t) : s.lente.provavel(d.t);
      }
    }

    const fimMeta = () => meta && (meta.textContent = s.lente.metaFim(toks.length));

    host.addEventListener('gen:token', (e) => {
      const { i, tok } = (e as CustomEvent<{ i: number; tok: HTMLElement }>).detail;
      if (meta) meta.textContent = s.lente.metaGerando(i + 1, toks.length);
      if (tok.dataset.alts) mostrar(tok, false);
    });
    host.addEventListener('gen:done', () => {
      gerando = false;
      fimMeta();
      const d = disputado();
      if (d) mostrar(d);
    });

    const escolher = (e: Event) => {
      if (gerando) return;
      const tok = (e.target as Element).closest?.<HTMLElement>('.tok[data-lens]');
      if (tok) mostrar(tok);
    };
    host.addEventListener('pointerover', escolher);
    host.addEventListener('focusin', escolher);
    host.addEventListener('click', escolher);

    temp.addEventListener('input', () => {
      tempOut.textContent = Number(temp.value).toFixed(1).replace('.', ',');
      if (atual) mostrar(atual);
    });

    lens.querySelector('[data-again]')!.addEventListener('click', () => {
      gerando = true;
      atual?.removeAttribute('data-active');
      nota.textContent = '';
      host.dispatchEvent(new CustomEvent('gen:replay', { bubbles: true }));
    });

    // Estado inicial: com geração automática o painel acompanha a frase; sem ela, já mostra a posição disputada.
    if (document.documentElement.classList.contains('gen-on')) {
      gerando = true;
      nota.textContent = '';
    } else {
      fimMeta();
      const d = disputado();
      if (d) mostrar(d);
    }
  }
</script>
