---
// Projetos como cartões que se empilham na rolagem: cada um fica preso no topo e encolhe um pouco
// quando o próximo passa por cima. No celular, viram uma lista normal.
import { Image, getImage } from 'astro:assets';
import BigTitle from './BigTitle.astro';
import CardapioJson from './CardapioJson.astro';
import { cartoes } from '../data/cartoes';
import posterSrc from '../assets/mcp-poster.webp';
import videoUrl from '../assets/infocaij-mcp-demo.mp4?url';
import gif from '../assets/mcp-demo.gif';
import maqEquipamento from '../assets/maq-equipamento.webp';
import kairoHoje from '../assets/kairo-painel-hoje.webp';
import kairoPente from '../assets/kairo-cliente-pente.webp';
import caijFluxo from '../assets/caij-fluxo.webp';
import coreInicio from '../assets/core-inicio.webp';
import coreNotas from '../assets/core-notas.webp';
import coreHistorico from '../assets/core-historico.webp';

const poster = await getImage({ src: posterSrc, format: 'webp', width: 960, quality: 75 });
interface Props { featured?: boolean; }
const { featured = false } = Astro.props;
const lista = cartoes.filter((c) => featured ? c.slug === 'infocaij' : c.slug !== 'infocaij');

// CoreUFABC: três telas do app, com o histórico fictício do repositório.
const celulares = [
  { src: coreInicio, alt: 'CoreUFABC, tela Início: CR, progressão curricular e próximas disciplinas (histórico fictício).' },
  { src: coreNotas, alt: 'CoreUFABC, tela Notas: CR, CA e CP e o simulador de CR (histórico fictício).' },
  { src: coreHistorico, alt: 'CoreUFABC, tela Histórico: progresso por eixo do currículo (histórico fictício).' },
];
---

<section class:list={['section', 'projetos', { destaque: featured }]} id={featured ? 'infocaij-destaque' : 'outros-projetos'} aria-label={featured ? 'InfoCAIJ em destaque' : 'Outros projetos'}>
  {!featured && <BigTitle text="Outros projetos" />}
  <div class="pilha">
    {
      lista.map((c, i) => (
        <article class="cartao" id={c.slug} aria-labelledby={`h-${c.slug}`} style={`--cor:var(--c-${c.cor})`}>
          <header class="topo">
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="tit">
              <p class="status">{c.status}</p>
              <h3 id={`h-${c.slug}`}>{c.nome}</h3>
            </div>
          </header>
          <div class="corpo">
            <div class="texto">
              <dl class="leitura">
                <div><dt>Problema</dt><dd>{c.problema}</dd></div>
                <div><dt>Solução</dt><dd>{c.solucao}</dd></div>
                <div><dt>Resultado</dt><dd>{c.resultado}</dd></div>
              </dl>
              <a class="detalhe" href={`/projetos/${c.slug}/`} aria-label={`Ver detalhes de ${c.nome}`}>
                Ver projeto <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="midia">
              {c.midia === 'video' && (
                <video controls muted playsinline preload="none" poster={poster.src} width="1908" height="986">
                  <source src={videoUrl} type="video/mp4" />
                  <img src={gif.src} width={gif.width} height={gif.height} alt="O InfoCAIJ MCP respondendo a perguntas no Claude Desktop." />
                </video>
              )}
              {c.midia === 'cardapio' && (
                <CardapioJson />
              )}
              {c.midia === 'carrossel' && (
                <figure class="captura">
                  <Image
                    src={c.slug === 'infocaij' ? caijFluxo : maqEquipamento}
                    alt={c.slug === 'infocaij' ? 'InfoCAIJ: fila da bancada e pedidos do dia no painel operacional.' : 'InfoMachine: leitura de hardware e andamento da triagem.'}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 900px) 46vw, 100vw"
                    loading="lazy"
                  />
                  <figcaption class="chip">{c.slug === 'infocaij' ? 'Painel operacional' : 'Triagem de hardware'}</figcaption>
                </figure>
              )}
              {c.midia === 'telas' && (
                <figure class="telas">
                  <Image
                    class="tela-pc"
                    src={kairoHoje}
                    alt="Painel do Kairo, tela Hoje: o dia de cada barbeiro em blocos, com horários livres e o espaço do copiloto (dados fictícios)."
                    widths={[640, 960, 1400]}
                    sizes="(min-width: 900px) 46vw, 100vw"
                    loading="lazy"
                  />
                  <Image
                    class="tela-cel"
                    src={kairoPente}
                    alt="Página pública do Kairo no celular: escolha do dia e dos horários livres (dados fictícios)."
                    widths={[240, 360, 480]}
                    sizes="(min-width: 900px) 12vw, 30vw"
                    loading="lazy"
                  />
                  <figcaption class="chip">painel e página pública · dados fictícios</figcaption>
                </figure>
              )}
              {c.midia === 'celulares' && (
                <figure class="celulares">
                  {celulares.map((t) => (
                    <Image src={t.src} alt={t.alt} widths={[240, 360, 520]} sizes="(min-width: 900px) 14vw, 30vw" loading="lazy" />
                  ))}
                  <figcaption class="chip">histórico fictício</figcaption>
                </figure>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .destaque { padding-top: 1rem; }
  .destaque .cartao { position: relative; top: auto; min-height: auto; }
  .destaque .pilha { padding-bottom: 0; }
  .projetos {
    padding-inline: var(--gutter);
    /* Os cartões presos dependem da altura real da seção. */
    content-visibility: visible;
  }
  .projetos :global(.big-title) {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .pilha {
    max-width: 78rem;
    margin-inline: auto;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .cartao {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: clamp(1.75rem, 3.5vw, 3.25rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }
  .topo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .num {
    flex: none;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1;
    color: var(--cor);
  }
  .tit { min-width: 0; }
  .status {
    margin: 0 0 0.375rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cor);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .detalhe {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.625rem 1.5rem;
    border-radius: 999px;
    background: var(--cor);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--t-fast) var(--ease);
    margin-top: 1.5rem;
  }
  .detalhe:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--cor) 85%, white);
  }
  .corpo {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .leitura {
    margin: 0;
    display: grid;
  }
  .leitura div {
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
  }
  .leitura dt {
    margin-bottom: 0.45rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cor);
  }
  .leitura dd {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.45;
  }
  .midia {
    border-radius: clamp(1.25rem, 2.6vw, 2.25rem);
    overflow: hidden;
    background: var(--surface);
    min-height: 14rem;
    display: grid;
  }
  .midia :global(img),
  .midia video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .midia video {
    object-fit: contain;
    background: #000;
  }

  .chip {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
  }
  .captura {
    position: relative;
    margin: 0;
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    padding-bottom: 3rem;
  }
  .captura :global(img) {
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  /* Kairo: o painel no computador, com a página pública no celular por cima, no canto. */
  .telas {
    position: relative;
    margin: 0;
    display: grid;
    align-content: center;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 2.5vw, 1.75rem) clamp(3rem, 5vw, 3.75rem);
    background: radial-gradient(circle at 85% 90%, color-mix(in srgb, var(--cor) 22%, transparent), transparent 60%), var(--surface);
  }
  .midia .telas :global(.tela-pc) {
    width: 84%;
    height: auto;
    object-fit: initial;
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.45);
  }
  .midia .telas :global(.tela-cel) {
    position: absolute;
    right: clamp(1rem, 2.5vw, 1.75rem);
    /* Acima da etiqueta "dados fictícios", que fica no pé. */
    bottom: clamp(3rem, 5vw, 3.75rem);
    width: 27%;
    height: auto;
    border-radius: 1.1rem;
    border: 3px solid #050506;
    box-shadow: 0 1.25rem 2.5rem rgb(0 0 0 / 0.6);
  }
  /* CoreUFABC: três telas do app lado a lado, a do meio um pouco acima. */
  .celulares {
    position: relative;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 1.75rem) clamp(3rem, 5vw, 3.75rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.5rem, 1.5vw, 1rem);
    align-items: center;
    background: radial-gradient(circle at 50% 100%, color-mix(in srgb, var(--cor) 22%, transparent), transparent 65%), var(--surface);
  }
  .midia .celulares :global(img) {
    height: auto;
    object-fit: initial;
    border-radius: 1rem;
    border: 3px solid #050506;
    box-shadow: 0 1.25rem 2.5rem rgb(0 0 0 / 0.5);
  }
  .midia .celulares :global(img:nth-of-type(2)) {
    transform: translateY(-6%);
  }

  @media (min-width: 900px) {
    .corpo {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
    }
    .midia {
      min-height: 18rem;
    }
  }
</style>
