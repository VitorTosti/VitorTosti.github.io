---
// Projetos como cartões que se empilham na rolagem: cada um fica preso no topo e encolhe um pouco
// quando o próximo passa por cima. No celular, viram uma lista normal.
import { Image, getImage } from 'astro:assets';
import BigTitle from './BigTitle.astro';
import { avaliacaoCardapio as av, cardapio, coreufabc, infocaij, infocaijMcp as mcp, infomachine } from '../data/projetos';
import { ptBR as s } from '../i18n/pt-BR';
import posterSrc from '../assets/mcp-poster.webp';
import videoUrl from '../assets/infocaij-mcp-demo.mp4?url';
import gif from '../assets/mcp-demo.gif';
import fotoCardapio from '../assets/cardapio_017.jpg';
import painel from '../assets/painel.png';

const poster = await getImage({ src: posterSrc, format: 'webp', width: 960, quality: 75 });
const [erroA, erroB] = av.preliminar.erros;

type Cartao = {
  slug: string;
  nome: string;
  status: string;
  resumo: string;
  fatos: string[];
  link: { rotulo: string; href: string | null };
  midia: 'video' | 'cardapio' | 'numeros' | 'painel' | 'rastro';
};

const cartoes: Cartao[] = [
  {
    slug: mcp.slug,
    nome: mcp.nome,
    status: 'destaque',
    resumo:
      'Servidor MCP somente leitura que liga o sistema interno InfoCAIJ ao Claude: 8 ferramentas, 3 prompts prontos e 20 testes, sem dependências.',
    fatos: [
      '✗ gargalo escolhido pela mediana (0,8 h) → ✓ pela soma de horas, com teste da cauda longa',
      '✗ descrição ambígua de ferramenta → ✓ passou a dizer qual data define o período',
      'Achou que 93 de 135 máquinas pulavam a etapa "Pronta"',
    ],
    link: { rotulo: 'GitHub', href: mcp.link.href },
    midia: 'video',
  },
  {
    slug: cardapio.slug,
    nome: cardapio.nome,
    status: 'em andamento',
    resumo: 'A foto do cardápio vira cardápio digital em JSON validado por esquema, com o que precisa de revisão humana marcado.',
    fatos: [
      `${av.cardapios} cardápios com gabarito · ${av.itens} itens · ${av.armadilhas.reduce((a, b) => a + b.n, 0)} armadilhas`,
      'Métrica principal: erro de preço silencioso',
      `Preliminar: R$ ${erroA.certo} lido como ${erroA.lido} e ${erroB.certo} como ${erroB.lido}, sem pedir revisão`,
    ],
    link: { rotulo: 'TODO: repositório', href: null },
    midia: 'cardapio',
  },
  {
    slug: infocaij.slug,
    nome: infocaij.nome,
    status: 'em produção',
    resumo: 'Plataforma interna que tirou do WhatsApp a venda e a preparação de notebooks da CAIJ Informática.',
    fatos: ['Fila de 8 etapas com checklist técnico de 10 itens', 'Integração com o ERP, nota fiscal e garantia com QR Code', 'Código privado'],
    link: { rotulo: 'Estudo de caso', href: infocaij.link.href },
    midia: 'numeros',
  },
  {
    slug: infomachine.slug,
    nome: infomachine.nome,
    status: 'em uso na bancada',
    resumo: 'App portátil de triagem de notebooks: lê o hardware, roda 5 testes e imprime a etiqueta térmica.',
    fatos: ['Cerca de 100 máquinas por semana', 'Roda de pendrive, em Windows e macOS', 'Atualizações verificadas por SHA-256'],
    link: { rotulo: 'GitHub', href: infomachine.link.href },
    midia: 'painel',
  },
  {
    slug: coreufabc.slug,
    nome: coreufabc.nome,
    status: 'protótipo',
    resumo: 'Lê o histórico do SIGAA, calcula CR, CA e CPk e simula a grade do próximo quadrimestre.',
    fatos: ['66 testes', 'CI no GitHub Actions'],
    link: { rotulo: 'GitHub', href: coreufabc.link.href },
    midia: 'rastro',
  },
];

const numeros = [
  { v: '~300', r: 'máquinas e pedidos por mês' },
  { v: '15', r: 'usuários em 4 perfis' },
  { v: '13 mil+', r: 'eventos de histórico' },
  { v: '95', r: 'arquivos de teste' },
];
const rastroCore = coreufabc.rastro.flatMap((p) =>
  p.tipo === 'chamada'
    ? [`${p.ferramenta}(${Object.entries(p.args).map(([k, v]) => `${k}: ${JSON.stringify(v)}`).join(', ')})`]
    : p.tipo === 'avaliacao'
      ? [`✓ ${p.itens.join(' · ')}`]
      : [],
);
---

<section class="section projetos" id="projetos">
  <BigTitle text={s.titulos.projetos} />
  <div class="pilha" data-pilha>
    {
      cartoes.map((c, i) => (
        <article class="cartao" id={c.slug} aria-labelledby={`h-${c.slug}`} style={`--i:${i}`} data-cartao>
          <header class="topo">
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="tit">
              <p class="status">{c.status}</p>
              <h3 id={`h-${c.slug}`}>{c.nome}</h3>
            </div>
            {c.link.href ? (
              <a class="ghost" href={c.link.href}>
                {c.link.rotulo} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="ghost todo">{c.link.rotulo}</span>
            )}
          </header>
          <div class="corpo">
            <div class="texto">
              <p class="resumo">{c.resumo}</p>
              <ul class="fatos">
                {c.fatos.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
            <div class="midia">
              {c.midia === 'video' && (
                <video controls muted playsinline preload="none" poster={poster.src} width="1908" height="986">
                  <source src={videoUrl} type="video/mp4" />
                  <img src={gif.src} width={gif.width} height={gif.height} alt="O InfoCAIJ MCP respondendo a perguntas no Claude Desktop." />
                </video>
              )}
              {c.midia === 'cardapio' && (
                <Image
                  src={fotoCardapio}
                  alt="Um dos cardápios sintéticos do conjunto de avaliação, fotografado."
                  widths={[480, 800]}
                  sizes="(min-width: 900px) 40vw, 100vw"
                  loading="lazy"
                />
              )}
              {c.midia === 'painel' && (
                <Image
                  src={painel}
                  alt="Painel do InfoMachine com o hardware lido da máquina (valores de exemplo)."
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 900px) 40vw, 100vw"
                  loading="lazy"
                />
              )}
              {c.midia === 'numeros' && (
                <dl class="nums">
                  {numeros.map((n) => (
                    <div>
                      <dt>{n.v}</dt>
                      <dd>{n.r}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {c.midia === 'rastro' && (
                <ol class="rastro mono">
                  {rastroCore.map((l) => (
                    <li>{l}</li>
                  ))}
                </ol>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projetos {
    padding-inline: var(--gutter);
    /* Os cartões presos dependem da altura real da seção. */
    content-visibility: visible;
  }
  .projetos :global(.big-title) {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .pilha {
    max-width: 78rem;
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
  }
  .cartao {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: clamp(1.5rem, 3vw, 2.75rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    transform-origin: 50% 0;
  }
  .topo {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'num tit' 'link link';
    gap: 0.75rem 1.25rem;
    align-items: end;
  }
  .num {
    grid-area: num;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--accent);
    font-variation-settings: 'opsz' 72;
  }
  .tit {
    grid-area: tit;
    min-width: 0;
  }
  .status {
    margin: 0 0 0.375rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ghost {
    grid-area: link;
    justify-self: start;
  }
  .corpo {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.5rem;
  }
  .resumo {
    font-size: 1.1875rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .fatos {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .fatos li {
    padding: 0.625rem 0;
    border-top: 1px solid var(--rule);
  }
  .midia {
    border-radius: clamp(1rem, 2vw, 1.75rem);
    overflow: hidden;
    background: var(--surface);
    min-height: 14rem;
    display: grid;
  }
  .midia :global(img),
  .midia video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .midia video {
    object-fit: contain;
    background: #000;
  }
  .nums {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .nums div {
    padding: clamp(1rem, 2.5vw, 2rem);
    display: grid;
    align-content: end;
    gap: 0.375rem;
    border: 1px solid var(--rule);
    margin: -1px 0 0 -1px;
  }
  .nums dt {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .nums dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .rastro {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    display: grid;
    align-content: center;
    gap: 0.875rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .rastro li::before {
    content: '→ ';
    color: var(--accent);
  }
  .rastro li:last-child {
    color: var(--ink);
  }
  @media (min-width: 900px) {
    .topo {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'num tit link';
    }
    .ghost {
      justify-self: end;
    }
    .corpo {
      grid-template-columns: 2fr 3fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    .midia {
      min-height: 20rem;
      max-height: 26rem;
    }
    /* Empilhamento: cada cartão fica preso um pouco abaixo do anterior. */
    .cartao {
      position: sticky;
      top: calc(5rem + var(--i) * 1.75rem);
    }
    .pilha {
      gap: 22vh;
      padding-bottom: 10vh;
    }
  }
</style>
