---
// Cardápio em 1 minuto: a foto ao lado do JSON que sai dela (gabarito do cardapio_017), com o item que
// o modelo marcou para revisão em destaque. As linhas aparecem em sequência ao entrar na tela
// (ver `linhas()` em motion-client). A cor vem de --cor, definida por quem usa o componente.
import { Image } from 'astro:assets';
import fotoCardapio from '../assets/cardapio_017.jpg';
import gabarito from '../assets/cardapio_017_gabarito.json';

interface Props {
  /** Tamanho da foto na página, para o navegador escolher a versão certa. */
  sizes?: string;
}
const { sizes = '(min-width: 900px) 34vw, 100vw' } = Astro.props;

type Linha = { t: string; recuo: number; revisar?: boolean; nota?: boolean };
const comum = gabarito.itens.find((i) => i.nome === 'Portuguesa')!;
const marcado = gabarito.itens.find((i) => i.revisar)!;
const js = (v: unknown) => JSON.stringify(v);
const linhas: Linha[] = [
  { t: '{', recuo: 0 },
  { t: `"restaurante": ${js(gabarito.restaurante)},`, recuo: 1 },
  { t: '"itens": [', recuo: 1 },
  { t: `{ "nome": ${js(comum.nome)}, "precos": [`, recuo: 2 },
  ...comum.precos.map((p, k) => ({
    t: `{ "tamanho": ${js(p.tamanho)}, "valor": ${js(p.valor)} }${k < comum.precos.length - 1 ? ',' : ''}`,
    recuo: 3,
  })),
  { t: '], "revisar": false },', recuo: 2 },
  { t: `// … mais ${gabarito.itens.length - 2} itens`, recuo: 2, nota: true },
  { t: `{ "nome": ${js(marcado.nome)},`, recuo: 2, revisar: true },
  { t: '"precos": [{ "tamanho": null, "valor": null }],', recuo: 3, revisar: true },
  { t: '"revisar": true,', recuo: 3, revisar: true },
  { t: `"motivo_revisao": ${js(marcado.motivo_revisao)} }`, recuo: 3, revisar: true },
  { t: ']', recuo: 1 },
  { t: '}', recuo: 0 },
];
---

<div class="foto-json">
  <figure class="foto">
    <Image
      src={fotoCardapio}
      alt="Um dos cardápios sintéticos do conjunto de avaliação, fotografado de lado."
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading="lazy"
    />
    <figcaption class="chip">foto</figcaption>
  </figure>
  <span class="seta" aria-hidden="true">→</span>
  <figure class="json">
    <pre class="mono" tabindex="0" aria-label="JSON extraído da foto" data-linhas>{linhas.map((l, k) => (
        <span class:list={['ln', { rev: l.revisar, nota: l.nota }]} style={`--r:${l.recuo};--k:${k}`}>{l.t}</span>
      ))}</pre>
    <figcaption class="chip">JSON validado por esquema</figcaption>
  </figure>
</div>

<style>
  .foto-json {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: 0.75rem;
    height: 100%;
  }
  figure {
    position: relative;
    margin: 0;
    border-radius: clamp(0.75rem, 1.5vw, 1.25rem);
    overflow: hidden;
  }
  .foto {
    aspect-ratio: 4 / 3;
  }
  .foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .seta {
    justify-self: center;
    align-self: center;
    font-family: var(--mono);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--cor, var(--accent));
    transform: rotate(90deg);
  }
  .json {
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  pre {
    margin: 0;
    padding: 0.875rem 1rem;
    font-size: 0.6875rem;
    line-height: 1.6;
    overflow: auto;
    color: var(--ink-2);
  }
  .ln {
    display: block;
    padding-left: calc(var(--r) * 1.25em);
    transition: opacity 260ms linear;
    transition-delay: calc(var(--k) * 55ms);
  }
  :global(.gen-on) [data-linhas]:not(:global(.vistas)) .ln {
    opacity: 0;
  }
  .ln.rev {
    color: var(--cor, var(--accent));
    background: color-mix(in srgb, var(--cor, var(--accent)) 12%, transparent);
  }
  .ln.nota {
    font-style: italic;
  }
  .chip {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
  }
  .json .chip {
    left: auto;
    right: 0.75rem;
    top: 0.75rem;
    bottom: auto;
  }
  @media (min-width: 640px) {
    .foto-json {
      grid-template-columns: 1fr auto 1.3fr;
      gap: 0.75rem;
    }
    .foto {
      aspect-ratio: auto;
    }
    .seta {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln {
      transition: none;
    }
  }
</style>
