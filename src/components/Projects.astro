---
import { Image } from 'astro:assets';
import GeneratedText from './GeneratedText.astro';
import ProjectMcp from './ProjectMcp.astro';
import ProjectShort from './ProjectShort.astro';
import MenuToJson from './MenuToJson.astro';
import { avaliacaoCardapio as av, cardapio, coreufabc, infocaij, infomachine } from '../data/projetos';
import { ptBR as s } from '../i18n/pt-BR';
import painel from '../assets/painel.png';
import testes from '../assets/testes.png';
import etiqueta from '../assets/etiqueta.png';

const capturas = [
  { src: painel, alt: 'Painel do InfoMachine com o hardware lido da máquina (valores de exemplo).', legenda: 'painel' },
  { src: testes, alt: 'Tela de testes do InfoMachine: câmera, teclado, som, tela e touchpad (valores de exemplo).', legenda: 'testes' },
  { src: etiqueta, alt: 'Pré-visualização da etiqueta térmica gerada pelo InfoMachine (valores de exemplo).', legenda: 'etiqueta' },
];
---

<section class="section" id="projetos">
  <div class="wide">
    <GeneratedText id="projetos" text={s.frases.projetos} as="h2" class="section-title" />
  </div>
  <ProjectMcp />

  <div class="wide">
    <ProjectShort p={cardapio} n={2}>
      <div class="conjunto">
        <p class="label">conjunto de avaliação</p>
        <dl>
          <div><dt>{av.cardapios}</dt><dd>cardápios sintéticos com gabarito exato</dd></div>
          <div><dt>{av.itens}</dt><dd>itens</dd></div>
          <div><dt>{av.estilos.length}</dt><dd>estilos visuais: {av.estilos.join(', ')}</dd></div>
          <div><dt>{av.niveisFoto}</dt><dd>níveis de foto</dd></div>
          <div>
            <dt>{av.armadilhas.reduce((a, b) => a + b.n, 0)}</dt>
            <dd>armadilhas: {av.armadilhas.map((a) => `${a.n} ${a.rotulo}`).join(', ')}</dd>
          </div>
        </dl>
      </div>
      <MenuToJson />
    </ProjectShort>

    <ProjectShort p={infocaij} n={3} />

    <ProjectShort p={infomachine} n={4}>
      <ul class="shots">
        {
          capturas.map((c) => (
            <li>
              <figure>
                <Image src={c.src} alt={c.alt} widths={[400, 640, 960]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
                <figcaption class="label">{c.legenda} · valores de exemplo</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </ProjectShort>

    <ProjectShort p={coreufabc} n={5} />
  </div>
</section>

<style>
  .conjunto dl {
    margin: 0.5rem 0 0;
    display: grid;
    border-top: 1px solid var(--rule);
  }
  .conjunto dl > div {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .conjunto dt {
    font-family: var(--mono);
    font-size: 1rem;
  }
  .conjunto dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.4;
  }
  .shots {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .shots figure {
    margin: 0;
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .shots figcaption {
    margin-top: 0.375rem;
  }
  @media (min-width: 900px) {
    .conjunto {
      max-width: var(--col);
    }
    .shots {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
