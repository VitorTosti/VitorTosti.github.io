---
import GeneratedText from './GeneratedText.astro';
import Lens from './Lens.astro';
import AutoAdvance from './AutoAdvance.astro';
import HeroField from './HeroField.astro';
import { alternativas } from '../data/alternativas';
import { resolveFrase } from '../lib/tokenize';
import { ptBR as s } from '../i18n/pt-BR';

const n = resolveFrase('abertura', s.frases.abertura, alternativas).length;
---

<header class="hero wide">
  <HeroField />
  <p class="label meta" data-hero-meta aria-hidden="true">{s.lente.metaFim(n)}</p>
  <h1>
    <span class="name">{s.nome}</span>
    <GeneratedText
      id="abertura"
      text={s.frases.abertura}
      as="span"
      class="line"
      trigger="load"
      keepCursor
      flicker
      lens
      elId="abertura-linha"
      seed={3}
    />
  </h1>
  <dl class="skills mono" aria-label={s.skillsRotulo}>
    {
      s.skills.map((g) => (
        <div class="grupo">
          <dt>{g.rot}</dt>
          <dd>
            <ul>
              {g.itens.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
  <GeneratedText
    text={s.sobre}
    as="p"
    class="sobre"
    elId="sobre-mim"
    startAfter="#abertura-linha"
    ritmo="rapido"
    seed={5}
  />
  <div class="adv-wrap">
    <AutoAdvance depoisDe="#sobre-mim" alvo="projetos" />
  </div>
  <div class="side">
    <Lens />
  </div>
  <div class="info">
    <p class="sub mono">{s.subtitulo}</p>
    <ul class="links mono">
      <li><a href={s.links.github} rel="me">GitHub ↗</a></li>
      <li><a href={s.links.linkedin} rel="me">LinkedIn ↗</a></li>
      {
        s.links.email ? (
          <li>
            <a href={`mailto:${s.links.email}`}>{s.links.email}</a>
          </li>
        ) : (
          <li class="todo">TODO: e-mail de contato</li>
        )
      }
    </ul>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(5rem, 14vh, 8rem);
    padding-bottom: 3rem;
    display: grid;
    grid-template-areas: 'meta' 'h1' 'skills' 'sobre' 'adv' 'side' 'info';
    column-gap: 4rem;
  }
  .meta {
    grid-area: meta;
    margin-bottom: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  h1 {
    grid-area: h1;
    display: block;
  }
  .hero :global(.sobre) {
    grid-area: sobre;
    margin: 1.75rem 0 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .skills {
    grid-area: skills;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.5rem;
    max-width: 44rem;
    font-size: 0.8125rem;
  }
  .grupo {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
  }
  .skills dt {
    color: var(--accent-text);
  }
  .skills dd {
    margin: 0;
  }
  .skills ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skills li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink);
  }
  @media (max-width: 639px) {
    .grupo {
      grid-template-columns: 1fr;
      margin-top: 0.25rem;
    }
  }
  .adv-wrap {
    grid-area: adv;
  }
  .side {
    grid-area: side;
    margin-top: 2.5rem;
  }
  .info {
    grid-area: info;
  }
  .name {
    display: block;
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-style: italic;
    letter-spacing: 0;
    color: var(--ink-2);
    margin-bottom: 0.75rem;
  }
  h1 :global(.line) {
    display: block;
    font-size: clamp(2.375rem, 8.2vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 15ch;
    font-variation-settings: 'opsz' 72;
  }
  .sub {
    margin: 2.5rem 0 1rem;
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 0.875rem;
  }
  .links a {
    display: inline-block;
    padding-block: 0.625rem;
  }
  .todo {
    padding-block: 0.625rem;
    color: var(--ink-2);
    border-bottom: 1px dashed var(--bar);
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1.8fr) minmax(18rem, 1fr);
      grid-template-areas:
        'meta meta'
        'h1 side'
        'skills side'
        'sobre side'
        'info side'
        'adv side';
      align-items: end;
      min-height: min(100svh, 56rem);
      align-content: center;
    }
    .side {
      margin-top: 0;
      align-self: end;
    }
    h1 :global(.line) {
      font-size: clamp(3rem, 4.6vw, 4.25rem);
      max-width: 18ch;
    }
  }
</style>
