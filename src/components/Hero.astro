---
import { ptBR as s } from '../i18n/pt-BR';
import { CURRICULO, temCurriculo } from '../lib/curriculo';

const projetos = [
  { nome: 'InfoCAIJ MCP', tipo: 'IA + dados reais', href: '/projetos/infocaij-mcp/', cor: 'ambar' },
  { nome: 'InfoCAIJ', tipo: 'Em produção', href: '/projetos/infocaij/', cor: 'agua' },
  { nome: 'Kairo', tipo: 'Agentes + produto', href: '/projetos/kairo/', cor: 'azul' },
] as const;
---

<header class="hero" data-hero>
  <canvas class="campo" data-campo aria-hidden="true"></canvas>
  <div class="luz" aria-hidden="true"></div>

  <nav class="nav" aria-label="Seções">
    <a class="assinatura" href="/" aria-label="Vitor Tosti, início">VT<span>.</span></a>
    <div class="nav-links">
      {s.nav.map((link) => <a href={link.href}>{link.rotulo}</a>)}
    </div>
  </nav>

  <div class="miolo">
    <div class="apresentacao">
      <p class="sobretitulo"><span class="sinal" aria-hidden="true"></span> Vitor Tosti <span class="barra">/</span> Software & IA aplicada</p>
      <h1>Ideias que viram <em>sistemas.</em></h1>
      <p class="descricao">Da pesquisa ao produto em uso. Construo tecnologia para resolver problemas reais.</p>
      <div class="acoes">
        <a class="pill principal" href="#projetos">Ver projetos <span aria-hidden="true">↗</span></a>
        <a class="ghost" href="#contato">Fale comigo</a>
        {temCurriculo && <a class="curriculo" href={CURRICULO} download>{s.curriculo} ↗</a>}
      </div>
    </div>

    <div class="constelacao" aria-label="Projetos em destaque">
      <div class="trilhas" aria-hidden="true">
        <span class="trilha trilha-a"></span>
        <span class="trilha trilha-b"></span>
        <span class="trilha trilha-c"></span>
        <span class="nucleo"><span>DO CÓDIGO<br />AO USO REAL</span></span>
      </div>
      {projetos.map((projeto, index) => (
        <a class:list={['projeto', `projeto-${index + 1}`]} href={projeto.href} style={`--cor: var(--c-${projeto.cor})`}>
          <span class="indice">0{index + 1} <span aria-hidden="true">↗</span></span>
          <strong>{projeto.nome}</strong>
          <small>{projeto.tipo}</small>
        </a>
      ))}
      <p class="explore">Explore os pontos <span aria-hidden="true">↗</span></p>
    </div>
  </div>

  <div class="base">
    <span>São Bernardo do Campo, SP</span>
    <a href="#projetos">Role para explorar <span aria-hidden="true">↓</span></a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(900px, 100svh);
    padding: 1.25rem var(--gutter) 1.5rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0e0e10;
    color: #eceae4;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(14 14 16 / 0.96) 0%, rgb(14 14 16 / 0.72) 48%, rgb(14 14 16 / 0.36) 100%),
      radial-gradient(circle at 75% 50%, rgb(63 208 189 / 0.08), transparent 36%),
      repeating-linear-gradient(0deg, transparent 0 55px, rgb(236 234 228 / 0.035) 56px),
      repeating-linear-gradient(90deg, transparent 0 55px, rgb(236 234 228 / 0.035) 56px);
  }
  .campo { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; opacity: 0.8; }
  .luz {
    position: absolute;
    z-index: -1;
    width: 40rem;
    height: 40rem;
    top: calc(var(--py, 48%) - 20rem);
    left: calc(var(--px, 72%) - 20rem);
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 163 58 / 0.1), transparent 66%);
    pointer-events: none;
    transition: top 0.5s ease-out, left 0.5s ease-out;
  }
  .nav, .miolo, .base { width: min(100%, 1440px); margin-inline: auto; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding-right: 7.25rem; position: relative; z-index: 2; }
  .assinatura { font-family: var(--mono); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.08em; text-decoration: none; }
  .assinatura span { color: var(--accent); }
  .nav-links { display: flex; gap: clamp(1rem, 3vw, 3.25rem); }
  .nav-links a, .base { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none; }
  .nav-links a { color: #b3b0a9; padding-block: 0.75rem; transition: color 160ms; }
  .nav-links a:hover { color: #fff; }
  .miolo { position: relative; flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(430px, 0.9fr); align-items: center; gap: 2rem; }
  .apresentacao { position: relative; z-index: 1; padding-block: 3rem; }
  .sobretitulo { display: flex; align-items: center; gap: 0.65rem; margin: 0 0 1.75rem; color: #b7b2a7; font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .sinal { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 1.1rem var(--accent); }
  .barra { color: var(--accent); }
  h1 { max-width: 12ch; font-size: clamp(4.25rem, 8vw, 9rem); line-height: 0.86; letter-spacing: -0.065em; font-weight: 400; }
  h1 em { display: block; color: var(--accent); font-weight: 400; }
  .descricao { max-width: 32ch; margin: 2rem 0 0; color: #b7b2a7; font-size: clamp(1.1rem, 1.8vw, 1.5rem); line-height: 1.35; }
  .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2.25rem; }
  .principal { gap: 1.5rem; }
  .curriculo { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; padding: 0.75rem; }
  .constelacao { position: relative; height: min(600px, 69svh); min-height: 430px; }
  .trilhas { position: absolute; inset: 8% 2%; opacity: 0.82; }
  .trilhas::before, .trilhas::after { content: ''; position: absolute; inset: 17%; border: 1px solid rgb(242 163 58 / 0.15); border-radius: 50%; transform: rotate(-22deg) scaleX(1.12); }
  .trilhas::after { inset: 29%; border-color: rgb(63 208 189 / 0.17); transform: rotate(28deg) scaleX(0.92); }
  .trilha { position: absolute; height: 1px; transform-origin: left center; background: linear-gradient(90deg, transparent, rgb(242 163 58 / 0.38), transparent); }
  .trilha-a { width: 57%; top: 31%; left: 20%; rotate: 24deg; }
  .trilha-b { width: 62%; top: 63%; left: 15%; rotate: -22deg; }
  .trilha-c { width: 45%; top: 27%; left: 56%; rotate: 100deg; }
  .nucleo { position: absolute; top: 48%; left: 51%; translate: -50% -50%; width: clamp(7rem, 13vw, 11rem); aspect-ratio: 1; border: 1px solid rgb(242 163 58 / 0.5); border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle, rgb(242 163 58 / 0.13), rgb(14 14 16 / 0.92) 72%); box-shadow: 0 0 5rem rgb(242 163 58 / 0.12), inset 0 0 2rem rgb(242 163 58 / 0.06); }
  .nucleo::before, .nucleo::after { content: ''; position: absolute; inset: -1.3rem; border: 1px dashed rgb(242 163 58 / 0.18); border-radius: 50%; animation: girar 34s linear infinite; }
  .nucleo::after { inset: -2.7rem; border-color: rgb(63 208 189 / 0.1); animation-direction: reverse; animation-duration: 48s; }
  .nucleo span { color: #f2a33a; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.13em; line-height: 1.7; text-align: center; }
  .projeto { position: absolute; z-index: 1; width: clamp(9rem, 14vw, 13rem); min-height: 7.75rem; display: flex; flex-direction: column; justify-content: space-between; gap: 0.35rem; padding: 0.85rem 1rem; border: 1px solid color-mix(in srgb, var(--cor) 38%, transparent); border-radius: 0.8rem; background: rgb(18 18 21 / 0.88); box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.28); text-decoration: none; backdrop-filter: blur(12px); transition: border-color 220ms, background 220ms, transform 300ms, box-shadow 300ms; }
  .projeto:hover, .projeto:focus-visible { color: #fff; border-color: var(--cor); background: #202023; transform: translateY(-8px) scale(1.03); box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--cor) 12%, transparent); }
  .projeto-1 { top: 6%; left: 4%; }
  .projeto-2 { top: 18%; right: 0; }
  .projeto-3 { bottom: 4%; left: 17%; }
  .indice { display: flex; justify-content: space-between; color: var(--cor); font-family: var(--mono); font-size: 0.68rem; }
  .projeto strong { font-size: 1.3rem; font-weight: 400; line-height: 1.05; }
  .projeto small { color: #a7a39b; font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .explore { position: absolute; bottom: 1%; right: 0; margin: 0; color: #77746e; font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .base { position: relative; z-index: 1; display: flex; justify-content: space-between; color: #858078; }
  .base a { text-decoration: none; }
  .base a span { color: var(--accent); margin-left: 0.5rem; }
  @keyframes girar { to { rotate: 360deg; } }
  @media (max-width: 960px) {
    .hero { min-height: 760px; }
    .miolo { grid-template-columns: minmax(0, 1fr) minmax(350px, 0.8fr); gap: 0; }
    h1 { font-size: clamp(4.3rem, 8vw, 6.5rem); }
    .constelacao { min-height: 400px; }
  }
  @media (max-width: 720px) {
    .hero { min-height: 100svh; padding-bottom: 1.25rem; }
    .campo { opacity: 0.42; }
    .nav { padding-right: 6.5rem; }
    .nav-links { display: none; }
    .miolo { display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: 0.25rem; }
    .apresentacao { padding-block: 2rem 0; }
    h1 { max-width: 11ch; font-size: clamp(4.1rem, 13vw, 6.5rem); }
    .descricao { margin-top: 1.25rem; font-size: 1.1rem; }
    .acoes { margin-top: 1.5rem; gap: 0.5rem; }
    .acoes :global(.pill), .acoes :global(.ghost) { padding-inline: 1.15rem; }
    .principal { gap: 0.75rem; }
    .constelacao { height: 305px; min-height: 305px; width: 100%; }
    .nucleo { width: 6.5rem; }
    .projeto { width: 8.75rem; min-height: 6.5rem; padding: 0.65rem 0.75rem; }
    .projeto strong { font-size: 1.1rem; }
    .projeto-1 { top: 2%; left: 0; }
    .projeto-2 { top: 7%; right: 0; }
    .projeto-3 { bottom: 3%; left: 8%; }
    .explore { bottom: 8%; }
    .base { display: none; }
  }
  @media (max-width: 390px) {
    .sobretitulo { font-size: 0.58rem; }
    h1 { font-size: 3.85rem; }
    .constelacao { height: 295px; min-height: 295px; }
    .projeto { width: 8rem; }
  }
  @media (max-width: 720px) and (max-height: 700px) {
    .apresentacao { padding-top: 0.75rem; }
    .sobretitulo { margin-bottom: 0.9rem; }
    h1 { font-size: clamp(3.3rem, 12vw, 4rem); }
    .descricao { margin-top: 0.75rem; font-size: 1rem; }
    .acoes { margin-top: 1rem; }
    .constelacao { height: 255px; min-height: 255px; }
    .projeto { min-height: 5.7rem; }
    .explore { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nucleo::before, .nucleo::after { animation: none; }
    .luz { display: none; }
    .projeto { transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-campo]');
  if (hero && canvas) {
    const context = canvas.getContext('2d');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodes = Array.from({ length: 48 }, (_, index) => ({
      x: ((index * 73 + 19) % 101) / 101,
      y: ((index * 41 + 11) % 97) / 97,
      phase: index * 1.7,
      size: index % 8 === 0 ? 2 : 1,
    }));
    let width = 0;
    let height = 0;
    let pointerX = 0.72;
    let pointerY = 0.48;
    let visible = true;
    let frame = 0;

    const resize = () => {
      const bounds = hero.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (reduced) draw(0);
    };
    const draw = (time: number) => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      const positions = nodes.map((node) => ({
        x: node.x * width + (reduced ? 0 : Math.sin(time * 0.00025 + node.phase) * 12) + (pointerX - 0.5) * (node.size === 2 ? 14 : 5),
        y: node.y * height + (reduced ? 0 : Math.cos(time * 0.0003 + node.phase) * 10) + (pointerY - 0.5) * (node.size === 2 ? 14 : 5),
      }));
      for (let index = 0; index < positions.length; index++) {
        const start = positions[index];
        for (let otherIndex = index + 1; otherIndex < positions.length; otherIndex++) {
          const end = positions[otherIndex];
          const distance = Math.hypot(start.x - end.x, start.y - end.y);
          if (distance > 150) continue;
          context.strokeStyle = `rgba(242, 163, 58, ${((1 - distance / 150) * 0.11).toFixed(3)})`;
          context.beginPath();
          context.moveTo(start.x, start.y);
          context.lineTo(end.x, end.y);
          context.stroke();
        }
        context.fillStyle = nodes[index].size === 2 ? 'rgba(242, 163, 58, 0.6)' : 'rgba(236, 234, 228, 0.25)';
        context.beginPath();
        context.arc(start.x, start.y, nodes[index].size, 0, Math.PI * 2);
        context.fill();
      }
      if (!reduced && visible) frame = requestAnimationFrame(draw);
    };

    hero.addEventListener('pointermove', (event) => {
      const bounds = hero.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left) / bounds.width;
      pointerY = (event.clientY - bounds.top) / bounds.height;
      hero.style.setProperty('--px', `${Math.round(pointerX * 100)}%`);
      hero.style.setProperty('--py', `${Math.round(pointerY * 100)}%`);
      if (reduced) draw(0);
    }, { passive: true });
    new ResizeObserver(resize).observe(hero);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame && !reduced) frame = requestAnimationFrame(draw);
      if (!visible) { cancelAnimationFrame(frame); frame = 0; }
    }).observe(hero);
    resize();
    if (!reduced) frame = requestAnimationFrame(draw);
  }
</script>
