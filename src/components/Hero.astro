---
// Abertura em uma tela: menu, o nome ocupando a largura inteira, uma frase e o botão de contato.
// O nome é "gerado": cada token sobe da linha de base e o cursor âmbar pisca no fim.
// O retrato fica no centro, por cima do nome, e segue o mouse quando ele chega perto (efeito ímã).
import { Image } from 'astro:assets';
import foto from '../assets/vitor.webp';
import { ptBR as s } from '../i18n/pt-BR';
import { splitFallback } from '../lib/tokenize';
import { CURRICULO, temCurriculo } from '../lib/curriculo';

const tokens = splitFallback(s.nome);
---

<header class="hero">
  <nav class="nav" aria-label="Seções">
    {
      s.nav.map((l) => (
        <a href={l.href} class="nav-a">
          {l.rotulo}
        </a>
      ))
    }
  </nav>

  <h1 class="nome" aria-label={s.nome}>
    {
      tokens.map((t, i) => (
        <span class="mask" aria-hidden="true">
          <span class="t" style={`--i:${i}`}>
            {t}
          </span>
        </span>
      ))
    }
    <span class="cur-wrap" aria-hidden="true"><span class="cur"></span></span>
  </h1>

  <div class="retrato">
    <div data-magnet>
      <Image
        src={foto}
        alt="Retrato de Vitor Tosti."
        widths={[320, 480, 720, 900]}
        sizes="(min-width: 640px) 24vw, 44vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="base">
    <p class="intro">{s.intro}</p>
    <div class="botoes">
      {
        temCurriculo && (
          <a class="ghost" href={CURRICULO} download>
            {s.curriculo}
          </a>
        )
      }
      <a class="pill" href={`mailto:${s.links.email}`}>{s.falar}</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem var(--gutter) 1.75rem;
    overflow-x: clip;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    animation: desce 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .nav-a {
    font-family: var(--mono);
    font-size: clamp(0.75rem, 1.3vw, 1.125rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding-block: 0.75rem;
    transition: color var(--t-fast) var(--ease);
  }
  .nome {
    margin: 0;
    display: flex;
    align-items: flex-end;
    white-space: nowrap;
    /* "Vitor Tosti" + cursor medem ~4,65em: o nome ocupa exatamente a largura útil. */
    font-size: min(calc((100vw - 2 * var(--gutter)) / 4.65), 26rem);
    font-weight: 400;
    font-variation-settings: 'opsz' 72;
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  /* Cada token sobe por trás de uma máscara, na ordem em que seria gerado. */
  .mask {
    display: inline-block;
    overflow: hidden;
    /* Folga para ascendentes e descendentes: a máscara não pode cortar a barra do T. */
    padding-block: 0.16em 0.08em;
    margin-block: -0.16em -0.08em;
    white-space: pre;
  }
  .t {
    display: inline-block;
    animation: sobe 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(150ms + var(--i) * 170ms);
  }
  .cur-wrap {
    display: inline-block;
    margin-left: 0.06em;
    margin-bottom: 0.1em;
    will-change: transform;
  }
  .cur {
    display: block;
    width: 0.32em;
    height: 0.62em;
    background: var(--accent);
    animation:
      aparece 400ms 650ms both,
      pisca 1.1s 1.2s steps(1) infinite;
  }
  /* Retrato: centralizado por cima do nome, entra subindo depois dele. */
  .retrato {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: clamp(12rem, 24vw, 23rem);
    transform: translate(-50%, -46%);
    animation: sobe-retrato 900ms 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
    pointer-events: none;
  }
  .retrato [data-magnet] {
    will-change: transform;
  }
  .retrato :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @keyframes sobe-retrato {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-46% + 30px));
    }
  }
  .base {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .intro {
    margin: 0;
    max-width: 19rem;
    font-family: var(--mono);
    font-size: clamp(0.75rem, 1.1vw, 0.9375rem);
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    animation: sobe-leve 700ms 350ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    animation: sobe-leve 700ms 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes sobe {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes sobe-leve {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes desce {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
  }
  @keyframes aparece {
    from {
      opacity: 0;
    }
  }
  @keyframes pisca {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 639px) {
    /* No celular, o nome quebra em duas linhas para continuar enorme. */
    .nome {
      flex-wrap: wrap;
      font-size: 36vw;
      line-height: 0.86;
    }
    .mask {
      white-space: normal;
    }
    /* No celular, o retrato entra no fluxo, entre o nome e a frase. */
    .retrato {
      position: static;
      transform: none;
      width: 44vw;
      margin: 1.5rem auto 0;
      animation-name: sobe-leve;
    }
    .base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .t,
    .intro,
    .botoes,
    .retrato,
    .cur {
      animation: none;
    }
  }
</style>
