---
// Duas faixas de skills que andam com a rolagem, em sentidos opostos. A lista real (para leitor de tela)
// é a primeira cópia; as repetições existem só para a faixa não ter fim visível.
import { ptBR as s } from '../i18n/pt-BR';

const [ia, prog, ferr] = s.skills;
const linhas = [
  { itens: [...ia.itens, ...ferr.itens], dir: 1 },
  { itens: prog.itens, dir: -1 },
];
---

<section class="marquee" aria-label={s.skillsRotulo} data-marquee>
  {
    linhas.map((l, k) => (
      <div class:list={['row', { vazada: k === 1 }]} data-dir={l.dir}>
        {[0, 1, 2].map((c) => (
          <ul class="faixa" aria-hidden={c > 0 ? 'true' : undefined}>
            {l.itens.map((it) => (
              <li>
                {it}
                <span class="sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
</section>

<style>
  .marquee {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    display: grid;
    gap: 0.25rem;
  }
  .row {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .faixa {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  li {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: clamp(2.25rem, 6.5vw, 6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 72;
  }
  .vazada li {
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--ink-2);
  }
  .sep {
    display: inline-block;
    width: 0.18em;
    height: 0.36em;
    margin-inline: 0.45em;
    background: var(--accent);
  }
</style>
