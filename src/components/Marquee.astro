---
// Duas faixas com todas as skills, correndo sem parar em sentidos opostos (só CSS, sem depender da rolagem).
// A lista real (para leitor de tela) é a primeira cópia; as repetições existem
// só para a faixa não ter fim visível. Com movimento reduzido, as faixas param e quebram em linhas.
import { ptBR as s } from '../i18n/pt-BR';

const [ia, prog, ferr] = s.skills;
const linhas = [
  { itens: [...ia.itens, ...ferr.itens], dir: 1 },
  { itens: prog.itens, dir: -1 },
];
---

<section class="marquee" aria-label={s.skillsRotulo} data-marquee>
  {
    linhas.map((l, k) => (
      <div class:list={['row', { vazada: k === 1 }]}>
        <div class:list={['trilho', { volta: l.dir < 0 }]}>
          {[0, 1].map((c) => (
            <ul class="faixa" aria-hidden={c > 0 ? 'true' : undefined}>
              {l.itens.map((it) => (
                <li>
                  {it}
                  <span class="sep" aria-hidden="true" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .marquee {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    display: grid;
    gap: 0.25rem;
  }
  .row {
    width: max-content;
  }
  /* Duas cópias idênticas: andar exatamente uma cópia (-50%) fecha o laço sem emenda. */
  .trilho {
    display: flex;
    animation: corre 55s linear infinite;
  }
  .trilho.volta {
    animation-direction: reverse;
    animation-duration: 45s;
  }
  .marquee:hover .trilho {
    animation-play-state: paused;
  }
  .faixa {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  li {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: clamp(2.25rem, 6.5vw, 6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 72;
  }
  .vazada li {
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--ink-2);
  }
  .sep {
    display: inline-block;
    width: 0.18em;
    height: 0.36em;
    margin-inline: 0.45em;
    background: var(--accent);
  }
  @keyframes corre {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row {
      width: auto;
      padding-inline: var(--gutter);
    }
    .trilho {
      animation: none;
      justify-content: center;
    }
    .faixa {
      flex-wrap: wrap;
      justify-content: center;
    }
    .faixa[aria-hidden] {
      display: none;
    }
    li {
      font-size: clamp(1.75rem, 4vw, 3rem);
    }
  }
</style>
