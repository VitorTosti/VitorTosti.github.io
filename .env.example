# Opcional. No GitHub Actions, defina como "Variables" do repositório (Settings > Secrets and variables > Actions > Variables).

# Estatísticas sem cookies (Plausible). Domínio cadastrado no Plausible, ex.: vitortosti.github.io
PUBLIC_PLAUSIBLE_DOMAIN=

# Endpoint do formulário de contato (Formspree, Web3Forms...). Sem ele, o formulário abre o app de e-mail.
PUBLIC_FORM_ENDPOINT=
